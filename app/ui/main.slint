import { StartupLogo, StartupGlyph } from "startup.slint";
import { ScrollView } from "std-widgets.slint";

// JetBrains Mono is embedded at build time so the launcher looks the same on a
// machine that does not have it installed. Four static weights cover 400-800.
import "./fonts/JetBrainsMono-Regular.ttf";
import "./fonts/JetBrainsMono-Medium.ttf";
import "./fonts/JetBrainsMono-SemiBold.ttf";
import "./fonts/JetBrainsMono-Bold.ttf";

import "./fonts/inter.ttf";
import "./fonts/unbounded.ttf";
import "./fonts/fraunces.ttf";
import "./fonts/sora.ttf";

export struct ThemeChoice {
    id: string, name: string, description: string,
    background: color, background-end: color, accent: color, accent-end: color,
    text-color: color, display-font: string,
}

export global ThemePalette {
    in-out property <bool> reduce-motion: false;
    in-out property <color> bg: #0a0618;
    in-out property <color> bg-end: #1c0f38;
    in-out property <color> panel: #221735e8;
    in-out property <color> panel-light: #36264de8;
    in-out property <color> border: #ffffff29;
    in-out property <color> text-color: #f4effd;
    in-out property <color> muted: #b9adc9;
    in-out property <color> accent: #ffc37a;
    in-out property <color> accent-end: #ff8a4d;
    in-out property <color> nav-accent: #ffc37a;
    in-out property <color> list-accent: #ffc37a;
    in-out property <color> on-accent: #27170c;
    in-out property <color> field: #171025;
    in-out property <color> danger: #ff9db1;
    in-out property <string> body-font: "Inter";
    in-out property <string> display-font: "Unbounded";
    in-out property <string> value-font: "Inter";
    in-out property <string> background-style: "galaxy";
    in-out property <float> selection-scale: 1;
    in-out property <float> display-opacity: 1;

}

// Critically bounded layout boxes, with physical response inside each box.
export global InteractionMotion {
    in-out property <float> clock: 0;
    in-out property <bool> reduced: false;
    pure callback sample(float, float, float, float) -> float;
    pure callback velocity(float, float, float, float) -> float;
}
component SpringValue inherits Rectangle {
    width: 0px; height: 0px;
    in property <float> target: 0;
    property <float> origin: 0;
    property <float> goal: 0;
    property <float> initial-speed: 0;
    property <float> began: 0;
    property <bool> reduced: InteractionMotion.reduced;
    out property <float> value: reduced ? target : InteractionMotion.sample(origin, goal, initial-speed, max(0, InteractionMotion.clock - began));
    property <float> speed: reduced ? 0 : InteractionMotion.velocity(origin, goal, initial-speed, max(0, InteractionMotion.clock - began));
    changed target => {
        // Read the old trajectory before retargeting, preserving position/velocity.
        let current-value = root.value;
        let current-speed = root.speed;
        root.origin = current-value;
        root.initial-speed = current-speed;
        root.goal = root.target;
        root.began = InteractionMotion.clock;
    }
    changed reduced => {
        if root.reduced { root.origin = root.target; root.goal = root.target; root.initial-speed = 0; root.began = InteractionMotion.clock; }
    }
}

// Every control is drawn here instead of using the platform style: the launcher
// has its own dark/light switch, and the platform widgets follow the system
// theme, which made the fields look out of place in the opposite mode.

component AppButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> enabled: true;
    in property <bool> dark: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> small: false;
    callback clicked;

    height: small ? 30px : 38px;
    clip: true;
    opacity: enabled ? 1.0 : 0.45;
    press := SpringValue { target: ta.pressed && root.enabled ? 1 : 0; }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(parent.width, (parent.width - 2px) * (1 - 0.035 * press.value));
        height: min(parent.height, (parent.height - 2px) * (1 - 0.09 * press.value));
    border-radius: 9px;
    border-width: 1px;

    border-color: primary
        ? ThemePalette.accent
        : danger
            ? ThemePalette.border
            : ThemePalette.border;
    background: primary
        ? (ta.pressed ? ThemePalette.accent-end : ta.has-hover ? ThemePalette.accent : ThemePalette.accent)
        : danger
            ? (ta.has-hover ? ThemePalette.panel-light : ThemePalette.field)
            : (ta.has-hover ? ThemePalette.panel-light : ThemePalette.field);

    Text {
        font-family: ThemePalette.body-font;
        text: root.label;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        font-size: small ? 11.5px : 13px;
        font-weight: 600;
        color: primary ? ThemePalette.on-accent : danger ? ThemePalette.danger : ThemePalette.text-color;
    }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }


}

// One line of text input. The width is set by the caller so the caret area always
// matches the card it lives in.
component AppField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;

    focus-motion := SpringValue { target: field.has-focus ? 1 : 0; }
    height: 34px;
    border-radius: 8px;
    border-width: 1px + min(1, max(0, focus-motion.value)) * 1px;
    clip: true;
    opacity: enabled ? 1.0 : 0.5;
    background: ThemePalette.field;
    border-color: !enabled
        ? ThemePalette.border
        : field.has-focus
            ? ThemePalette.accent
            : ThemePalette.border;

    // TextInput has no placeholder in this Slint version, so the hint is drawn
    // behind the input and hidden as soon as there is text.
    Text {
        font-family: ThemePalette.body-font;
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "";
        text: root.placeholder;
        font-size: 13px;
        color: ThemePalette.muted;
    }

    field := TextInput {
        font-family: ThemePalette.body-font;
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        enabled: root.enabled;
        text <=> root.text;
        vertical-alignment: center;
        font-size: 13px;
        color: ThemePalette.text-color;
    }
}

component AppSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;
    callback toggled;

    knob := SpringValue { target: root.checked ? 1 : 0; }
    height: 26px;
    opacity: enabled ? 1.0 : 0.45;

    Text {
        font-family: ThemePalette.body-font;
        x: 0px;
        y: 0px;
        width: root.width - 46px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 12.5px;
        color: ThemePalette.text-color;
    }

    Rectangle {
        x: root.width - 38px;
        y: 3px;
        width: 38px;
        height: 21px;
        border-radius: 11px;
        background: root.checked ? ThemePalette.accent : ThemePalette.border;

        Rectangle {
            x: 2px + min(1.08, max(-0.08, knob.value)) * 17px;
            y: 2px;
            width: 17px;
            height: 17px;
            border-radius: 9px;
            background: root.checked ? #ffffff : ThemePalette.muted;
        }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
}

// One row per instance. Selection is driven by the window's instance-index, so the
// highlighted row always matches what Play will launch.
component ProfileRow inherits Rectangle {
    in property <float> entered: 1;
    press := SpringValue { target: ta.pressed ? 1 : 0; }
    opacity: max(0, min(1, entered));
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> dark: true;
    callback clicked;

    height: 64px;
    border-radius: 16px;
    border-width: 1px;
    border-color: selected ? ThemePalette.list-accent : transparent;
    background: selected
        ? ThemePalette.panel-light
        : (ta.has-hover ? ThemePalette.panel-light : transparent);
    clip: true;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Rectangle { x: 13px; y: 12px; width: 40px; height: 40px; border-radius: 12px; background: ThemePalette.accent; }
    Text {
        font-family: ThemePalette.body-font;
        x: 66px + (1 - root.entered) * 22px + press.value * 3px;
        y: press.value * 1px;
        width: root.width - 80px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 12.5px;
        font-weight: root.selected ? 600 : 500;
        color: ThemePalette.text-color;
    }
}

component HomeCard inherits Rectangle {
    in property <float> scale: 1;
    in property <string> title;
    in property <string> detail;
    in property <int> index;
    in property <bool> selected;
    in property <bool> busy;
    callback select;
    callback play;
    width: 367px * scale; height: 610px * scale;
    Image { width: 100%; height: 100%; image-fit: fill;
        source: ThemePalette.background-style == "dawn" ? @image-url("shell/card-alba.svg") : ThemePalette.background-style == "constellation" ? @image-url("shell/card-cartografo.svg") : @image-url("shell/card-horizonte.svg");
    }
    Rectangle { width: 100%; height: 100%; border-radius: 27px * root.scale; border-width: root.selected ? 1.5px : 0px; border-color: ThemePalette.accent.with-alpha(0.65); background: transparent; }
    Image { x: 28px * root.scale; y: 28px * root.scale; width: 64px * root.scale; height: 64px * root.scale; image-fit: contain;
        source: mod(root.index,4) == 0 ? @image-url("shell/profile-0.svg") : mod(root.index,4) == 1 ? @image-url("shell/profile-1.svg") : mod(root.index,4) == 2 ? @image-url("shell/profile-2.svg") : @image-url("shell/profile-3.svg");
    }
    Text { x: 28px * root.scale; y: 112px * root.scale; width: parent.width - 56px * root.scale; text: root.title; overflow: elide; font-family: ThemePalette.display-font; font-size: 22px * root.scale; font-weight: 800; color: ThemePalette.text-color; }
    Text { x: 28px * root.scale; y: 144px * root.scale; width: parent.width - 56px * root.scale; text: root.detail; overflow: elide; font-family: ThemePalette.body-font; font-size: 12px * root.scale; color: ThemePalette.muted; }
    Text { visible: root.height >= 450px * root.scale; x: 28px * root.scale; y: 182px * root.scale; text: "THIS WEEK"; font-family: ThemePalette.body-font; font-size: 10px * root.scale; font-weight: 700; letter-spacing: 2px; color: ThemePalette.muted.with-alpha(0.65); }
    Rectangle { visible: root.height >= 450px * root.scale; x: 28px * root.scale; y: 210px * root.scale; width: parent.width - 56px * root.scale; height: 66px * root.scale;
        Text { width: 100%; height: 100%; text: "Activity not recorded"; vertical-alignment: center; font-family: ThemePalette.body-font; font-size: 12px * root.scale; color: ThemePalette.muted.with-alpha(0.55); }
    }
    Text { x: 28px * root.scale; y: parent.height - 148px * root.scale; text: "Play time not recorded"; font-family: ThemePalette.body-font; font-size: 14px * root.scale; color: ThemePalette.text-color; }
    Text { x: 28px * root.scale; y: parent.height - 122px * root.scale; text: "Last session: not recorded"; font-family: ThemePalette.body-font; font-size: 13px * root.scale; color: ThemePalette.muted; }
    TouchArea { mouse-cursor: pointer; clicked => { root.select(); } }
    if root.selected : Rectangle {
        x: 28px * root.scale; y: parent.height - 84px * root.scale; width: parent.width - 56px * root.scale; height: 58px * root.scale;
        border-radius: 17px * root.scale; background: ThemePalette.accent;
        Image { width: 100%; height: 100%; image-fit: fill; source: ThemePalette.background-style == "dawn" ? @image-url("shell/play-alba.svg") : ThemePalette.background-style == "constellation" ? @image-url("shell/play-cartografo.svg") : @image-url("shell/play-horizonte.svg"); }
        press := SpringValue { target: hit.pressed && !root.busy ? 1 : 0; }
        Text { x: (root.busy ? 0px : 12px * root.scale) + press.value * 2px; width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: root.busy ? "WORKING..." : "PLAY"; font-family: ThemePalette.body-font; font-size: 17px * root.scale; font-weight: 800; letter-spacing: 3px; color: ThemePalette.on-accent; }
        Image { visible: !root.busy; x: parent.width / 2 - 57px * root.scale + press.value * 2px; y: (parent.height - self.height) / 2; width: 18px * root.scale; height: self.width; source: @image-url("tabler/player-play.svg"); colorize: ThemePalette.on-accent; }
        hit := TouchArea { mouse-cursor: root.busy ? default : pointer; clicked => { if !root.busy { root.play(); } } }
    }
    if !root.selected : Rectangle {
        x: 28px * root.scale; y: parent.height - 76px * root.scale; width: parent.width - 56px * root.scale; height: 42px * root.scale;
        Rectangle { x: 0px; y: 0px; width: 42px * root.scale; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: ThemePalette.border; background: ThemePalette.panel-light;
            Image { x: 14px * root.scale; y: 14px * root.scale; width: 14px * root.scale; height: 14px * root.scale; source: @image-url("tabler/player-play.svg"); colorize: ThemePalette.muted; }
        }
        Text { x: 52px * root.scale; height: parent.height; vertical-alignment: center; text: "Play"; font-family: ThemePalette.body-font; font-size: 14px * root.scale; color: ThemePalette.muted; }
        TouchArea { mouse-cursor: root.busy ? default : pointer; clicked => { if !root.busy { root.select(); root.play(); } } }
    }
}
component GlassPanel inherits Rectangle {
    border-radius: 27px; border-width: 1px; border-color: ThemePalette.border;
    background: ThemePalette.panel; clip: true;

}
component SectionRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected;
    in property <float> entered: 1;
    callback clicked;
    height: root.width < 240px ? 66px : 46px; border-radius: 14px; clip: true;
    background: selected ? ThemePalette.panel-light : hit.has-hover ? ThemePalette.field : transparent;
    border-width: 1px; border-color: selected ? ThemePalette.nav-accent : transparent;
    opacity: min(1, max(0, entered));
    press := SpringValue { target: hit.pressed ? 1 : 0; }
    Text { x: 12px + press.value * 2px; y: 0px; width: root.width < 240px ? parent.width - 24px : parent.width * 0.53; height: root.width < 240px ? 32px : parent.height; text: root.label; overflow: elide; vertical-alignment: center; font-family: ThemePalette.body-font; font-size: 14px; font-weight: 600; color: ThemePalette.text-color; }
    Text { x: root.width < 240px ? 12px : parent.width * 0.55; y: root.width < 240px ? 29px : 0px; width: root.width < 240px ? parent.width - 24px : parent.width * 0.45 - 12px; height: root.width < 240px ? 28px : parent.height; text: root.value; overflow: elide; horizontal-alignment: root.width < 240px ? left : right; vertical-alignment: center; font-family: ThemePalette.value-font; font-size: 10px; color: ThemePalette.muted; }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
component ThemeRow inherits Rectangle {
    in property <ThemeChoice> choice;
    in property <bool> selected;
    in property <float> entered: 1;
    callback clicked;
    height: 82px; clip: true;
    opacity: max(0,min(1,entered));
    press := SpringValue { target: hit.pressed ? 1 : 0; }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 + (1 - root.entered) * 12px;
        width: min(parent.width - 2px, (parent.width - 4px - press.value * 4px) * (root.selected ? ThemePalette.selection-scale : 1));
        height: min(parent.height - 2px, (parent.height - 4px) * (root.selected ? ThemePalette.selection-scale : 1));
        border-radius: 14px; border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? ThemePalette.accent : ThemePalette.border;
        background: ThemePalette.field;
        Rectangle { x: 12px; y: 14px; width: 42px; height: 44px; border-radius: 9px; background: root.choice.background;
            Rectangle { x: 6px; y: 28px; width: 30px; height: 8px; border-radius: 4px; background: @linear-gradient(90deg, root.choice.accent, root.choice.accent-end); }
        }
        Text { x: 66px; y: 12px; width: parent.width - 146px; text: root.choice.name; font-family: root.choice.display-font; font-size: 15px; font-weight: 700; color: ThemePalette.text-color; overflow: elide; }
        Text { x: 66px; y: 38px; width: parent.width - 82px; text: root.choice.description; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; wrap: word-wrap; }
        Text { x: parent.width - 72px; y: 15px; width: 60px; text: root.selected ? "APPLIED" : "APPLY"; horizontal-alignment: right; font-family: ThemePalette.body-font; font-size: 9px; font-weight: 700; color: root.selected ? ThemePalette.accent : ThemePalette.muted; }
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Native Home prototype. Keeps MainWindow bindings and callbacks intact.
component ReworkHome inherits Rectangle {
    in property <bool> reference-skin: true;
    in property <string> theme-label: "HORIZONTE";
    in property <[string]> names;
    in property <[string]> titles;
    in property <[string]> details;
    in property <[string]> versions;
    in property <[string]> loaders;
    in property <[string]> initials;
    in property <int> selected;
    in property <bool> busy;
    in property <string> status;
    callback select(int);
    callback play();
    callback new-instance();
    callback library();
    callback options();
    property <bool> small: self.width < 1000px;
    property <length> gap: small ? 9px : 13px;
    property <length> tile-height: small ? 79px : 85px;
    property <length> new-width: small ? 84px : 156px;
    property <length> hero-height: self.height - tile-height - (small?82px:95px);
    property <string> chosen-title: selected >= 0 && selected < titles.length ? titles[selected] : "Choose an instance";
    property <bool> structured-detail: selected >= 0 && selected < versions.length && selected < loaders.length;
    property <string> chosen-version: structured-detail ? versions[selected] : "";
    property <string> chosen-loader: structured-detail ? loaders[selected] : "";
    property <string> chosen-detail: selected >= 0 && selected < details.length ? details[selected] : "Your library is ready for a new instance";
    hero := Rectangle {
        x:0px;y:0px;width: 100%; height: root.hero-height;
        border-radius: 28px; clip: true;
        background: ThemePalette.field;
        Image { x:0px;y:0px;width:100%;height:100%;source:@image-url("shell/rework-cover-treated.png");image-fit:cover; }
        Rectangle { x:0px;y:0px;width:100%;height:100%;background:@linear-gradient(90deg,#0f0b19f5 0%,#130d1cc2 26%,#17112028 66%); }
        Rectangle { x:0px;y:0px;width:100%;height:100%;background:@linear-gradient(0deg,#0e0a17d9,transparent 65%); }
        Rectangle { x:0px;y:0px;width:100%;height:100%;border-radius:28px;border-width:1px;border-color:@linear-gradient(180deg,#ffffff30 0%,#ffffff1b 10%,#ffffff1b 100%);background:transparent; }
        Text {x:parent.width - 105px;y:25px;width:78px;text:root.selected >= 0 && root.selected < root.names.length ? (root.selected < 9 ? "0" : "") + (root.selected + 1) + " / " + (root.names.length < 10 ? "0" : "") + root.names.length : "00 / 00";horizontal-alignment:right;font-family:ThemePalette.display-font;font-weight:450;font-size:11px;letter-spacing:2px;color:#ffffff9c;}
        Rectangle {
            x:root.small?29px:39px; y:parent.height - (root.small?224px:232px); width:parent.width - (root.small?56px:76px);height:208px;
            Rectangle {x:0px;y:root.small?11.5px:1.5px;width:5px;height:5px;border-radius:2.5px;background:#c6a2fd;drop-shadow-color:#c6a2fd60;drop-shadow-blur:10px;}
            Text {x:14px;y:root.small?8px:-2px;text:"SELECTED INSTANCE";font-family:ThemePalette.body-font;font-size:10px;font-weight:600;letter-spacing:2px;color:#c1b3d7;}
            Text {x:0px;y:root.small?34px:24px;width:100%;height:66px;text:root.chosen-title;overflow:elide;font-family:ThemePalette.display-font;font-size:root.small?42px:51px;font-weight:570;letter-spacing:-2px;color:#f8f6ff;}
            if !root.structured-detail : Text {x:0px;y:100px;width:100%;text:root.names.length > 0 ? "Minecraft " + root.chosen-detail + " · Java Edition" : root.chosen-detail;overflow:elide;font-family:ThemePalette.body-font;font-size:13px;color:#c7c0d3;}
            if root.structured-detail : Rectangle {x:0px;y:98px;width:100%;height:20px;clip:true;
                HorizontalLayout {alignment:start;spacing:11px;
                    Text {text:"Minecraft " + root.chosen-version;vertical-alignment:center;font-family:ThemePalette.body-font;font-size:13px;color:#c7c0d3;}
                    Rectangle {width:3px; Rectangle {x:0px;y:(parent.height - 3px)/2;width:3px;height:3px;border-radius:1.5px;background:#8e849f;}}
                    Text {text:root.chosen-loader;vertical-alignment:center;font-family:ThemePalette.body-font;font-size:13px;color:#d9c3ff;}
                    Rectangle {width:3px; Rectangle {x:0px;y:(parent.height - 3px)/2;width:3px;height:3px;border-radius:1.5px;background:#8e849f;}}
                    Text {text:"Java Edition";vertical-alignment:center;font-family:ThemePalette.body-font;font-size:13px;color:#c7c0d3;}
                }
            }
            Rectangle {x:0px;y:root.small?144px:146px;width:181px;height:51px;border-radius:18px;border-width:1px;border-color:root.reference-skin?#ffe1bc70:ThemePalette.border;background:root.reference-skin?@linear-gradient(140deg,#ffd39e,#e8ab75):@linear-gradient(140deg,ThemePalette.accent,ThemePalette.accent-end);drop-shadow-color:#d69b5228;drop-shadow-blur:28px;drop-shadow-offset-y:6px;inner-shadow-color:#ffffff77;inner-shadow-blur:0px;inner-shadow-offset-y:1px;
                Image {x:62px;y:17px;width:17px;height:17px;source:@image-url("coolicons/play.svg");colorize:root.reference-skin?#342014:ThemePalette.on-accent;}
                Text {x:89px;y:0px;height:100%;text:root.busy?"Working…":"Play";vertical-alignment:center;font-family:ThemePalette.body-font;font-size:15px;font-weight:650;color:root.reference-skin?#342014:ThemePalette.on-accent;}
                TouchArea {x:0px;y:0px;width:100%;height:100%;mouse-cursor:root.busy?default:pointer; clicked => {if !root.busy && root.names.length > 0 {root.play();}}}
            }
            Rectangle {x:191px;y:root.small?145px:147px;width:49px;height:49px;border-radius:17px;border-width:1px;border-color:@linear-gradient(180deg,#ffffff42,#ffffff24);background:@linear-gradient(135deg,#ffffff19,#ffffff07);backdrop-blur:15px;
                Image {x:16px;y:16px;width:17px;height:17px;source:@image-url("coolicons/settings.svg");colorize:#ddd3e9;}
                TouchArea {x:0px;y:0px;width:100%;height:100%;mouse-cursor:pointer; clicked => {root.options();}}
            }
        }
        Rectangle {x:root.small?280px:300px;y:parent.height - 89px;width:parent.width - self.x - 28px;height:66px;
            Text {x:0px;y:0px;width:100%;height:100%;text:root.status;wrap:word-wrap;overflow:elide;vertical-alignment:center;font-family:ThemePalette.body-font;font-size:12px;color:#e4dbee;}
        }
    }
    Text {x:2px;y:hero.height + (root.small?22px:25px);text:"Your instances";letter-spacing:-0.3px;font-family:ThemePalette.body-font;font-size:15px;font-weight:560;color:ThemePalette.text-color;}
    Rectangle {x:parent.width - 106px;y:hero.height + (root.small?18px:21px);width:104px;height:28px;
        Text {width:100%;height:100%;text:"Open library  ↗";horizontal-alignment:right;vertical-alignment:center;font-family:ThemePalette.body-font;font-size:11px;color:ThemePalette.muted;}
        TouchArea {x:0px;y:0px;width:100%;height:100%;mouse-cursor:pointer; clicked => {root.library();}}
    }
    ScrollView { x:0px;y:hero.height + (root.small?55px:58px);width:parent.width - root.new-width - root.gap;height:root.tile-height + 14px;horizontal-scrollbar-policy:as-needed;vertical-scrollbar-policy:always-off;
        HorizontalLayout {spacing:root.gap;alignment:start;
            for name[i] in root.names : Rectangle {
                width: max(190px,(root.width - root.new-width - root.gap * 3) / 3);height:root.tile-height;border-radius:root.small?17px:20px;border-width:1px;border-color:root.reference-skin?(i==root.selected?#bba1df51:#ffffff0d):(i==root.selected?ThemePalette.accent:ThemePalette.border);background:root.reference-skin?(i==root.selected?@linear-gradient(110deg,#332541,#21182f):#17121f):(i==root.selected?ThemePalette.panel-light:ThemePalette.panel);
                Rectangle {x:root.small?12px:16px;y:(parent.height - self.height)/2;width:root.small?40px:51px;height:root.small?46px:51px;border-radius:root.small?11px:14px;background:i==0?#9b7bbd:i==1?@linear-gradient(135deg,#42514c,#1c2728):@linear-gradient(135deg,#695040,#2a2222);clip:true;
                    if i == 0 : Image {x:0px;y:0px;width:100%;height:100%;image-fit:cover;source:@image-url("shell/rework-cover.jpg");}
                    if i != 0 : Text {width:100%;height:100%;text:i < root.initials.length ? root.initials[i] : "?";horizontal-alignment:center;vertical-alignment:center;font-family:ThemePalette.body-font;font-size:20px;color:#e8dcfb;}
                }
                Text {x:root.small?62px:82px;y:23px;width:parent.width - self.x - 14px;text:i < root.titles.length ? root.titles[i] : name;overflow:elide;font-family:ThemePalette.body-font;font-size:root.small?11px:13px;font-weight:550;color:ThemePalette.text-color;}
                Text {x:root.small?62px:82px;y:48px;width:parent.width - self.x - 14px;text:i < root.versions.length && i < root.loaders.length ? root.versions[i] + "   ·   " + root.loaders[i] : i < root.details.length ? root.details[i] : "";overflow:elide;font-family:ThemePalette.body-font;font-size:root.small?9px:11px;color:ThemePalette.muted;}
                if i == root.selected && !root.small : Text {x:parent.width - 31px;y:14px;width:16px;text:"✓";font-family:ThemePalette.body-font;font-size:12px;color:root.reference-skin?#c8a6fc:ThemePalette.accent;}
                TouchArea {x:0px;y:0px;width:100%;height:100%;mouse-cursor:root.busy?default:pointer;clicked=>{if !root.busy {root.select(i);}}}
            }
        }
    }
    Rectangle {x:parent.width - root.new-width;y:hero.height + (root.small?55px:58px);width:root.new-width;height:root.tile-height;
        Image {x:0px;y:0px;width:100%;height:100%;image-fit:fill;source:root.small?@image-url("shell/rework-new-small.svg"):@image-url("shell/rework-new-wide.svg");}
        Image {x:(parent.width - 24px)/2;y:12px;width:24px;height:24px;source:@image-url("coolicons/plus.svg");colorize:ThemePalette.muted;}
        Text {x:0px;width:100%;y:50px;text:"New instance";horizontal-alignment:center;font-family:ThemePalette.body-font;font-size:root.small?9px:11px;color:ThemePalette.muted;}
        TouchArea {x:0px;y:0px;width:100%;height:100%;mouse-cursor:root.busy?default:pointer;clicked=>{if !root.busy {root.new-instance();}}}
    }
    Text {x:2px;y:parent.height - (root.small?11px:16px);text:"ANDROMEDA  /  " + root.theme-label;font-family:ThemePalette.body-font;font-size:root.small?8px:9px;letter-spacing:0.8px;color:#766d83;}
    Text {x:0px;y:parent.height - 14px;width:100%;text:"Native UI proof · Test data";horizontal-alignment:right;font-family:ThemePalette.body-font;font-size:9px;color:#968aa5;}
}

export component MainWindow inherits Window {
    title: @tr("Andromeda Launcher");
    icon: @image-url("branding/planet.svg");
    preferred-width: 1600px;
    preferred-height: 900px;
    min-width: 860px;
    min-height: 620px;

    in-out property <bool> reduce-animations;
    in-out property <bool> dark-mode: true;
    in-out property <bool> intro-visible: false;
    in property <bool> startup-overlay: false;
    in property <float> startup-reveal: 1;
    in property <color> startup-ink: white;
    in property <[StartupGlyph]> startup-glyphs;
    in property <float> startup-x: 0;
    in property <float> startup-y: 0;
    in property <float> startup-width: 720;
    out property <float> startup-dest-x: root.width < 1000px ? 24 : 36;
    out property <float> startup-dest-y: root.width < 1000px ? 27 : 33;
    out property <float> startup-dest-width: root.width < 1000px ? 157 : 205;
    in property <image> intro-frame;
    in property <[string]> profile-titles;
    in property <[string]> profile-details;
    in property <[string]> profile-versions;
    in property <[string]> profile-loaders;
    in property <[string]> profile-initials;
    in property <[string]> instance-names: ["Default profile (phase 2)"];
    in-out property <int> instance-index: 0;
    in-out property <string> instance-name: "New instance";
    in property <[string]> version-choices: [];
    in-out property <int> version-filter: 0;
    in-out property <int> version-index: 0;
    in-out property <int> loader-index: 0;
    in property <[bool]> loader-available: [true, false, false, false, false, false, false];
    in property <[string]> loader-version-choices: [];
    in-out property <int> loader-version-index: 0;
    callback version-refresh(int);
    callback version-picked(int);
    callback loader-picked(int);
    in property <[string]> mod-rows: [];
    in property <[string]> mod-row-details: [];
    in-out property <int> mod-index: 0;
    in property <[string]> mod-results: [];
    in property <[string]> mod-result-details: [];
    in-out property <int> mod-result-index: 0;
    in-out property <string> mod-query: "";
    in-out property <string> mod-status: "";
    in property <bool> mod-supported: false;
    callback mods-refresh();
    callback mod-toggle();
    callback mod-remove();
    callback mod-update();
    callback mods-search();
    callback mod-install();

        in-out property <bool> trash-armed: false;
    in-out property <bool> can-restore: false;
    callback instance-selected(int);
    callback manage-instance(string, string);
    in-out property <bool> auth-busy: false;
    in-out property <bool> use-microsoft: false;
    in-out property <string> account-status: "Not signed in. Local offline profiles are still available.";
    callback account-action(string);
    callback settings-changed();
    callback launch-offline(string);
    in-out property <string> local-name: "Player";
    in-out property <bool> launch-busy: false;
    in-out property <string> launch-status: "Choose a profile, then Play. Installed files are verified before launch.";

    // Two screens: Play (default) and settings. The account, creation and
    // appearance controls live on the second one, which is what keeps Play calm.
    in-out property <bool> settings-open: false;

    in-out property <bool> appearance-open: false;
    in-out property <string> selected-theme: "horizonte";
    in property <[ThemeChoice]> theme-choices;
    in property <string> theme-status;
    callback theme-selected(string);
    property <color> c-bg: ThemePalette.bg;
    property <color> c-panel: ThemePalette.panel;
    property <color> c-border: ThemePalette.border;
    property <color> c-text: ThemePalette.text-color;
    property <color> c-muted: ThemePalette.muted;
    property <bool> busy: launch-busy || auth-busy;
    // Never index the model blindly: an empty or stale model must not panic.
    property <string> current-profile: instance-index >= 0 && instance-index < instance-names.length
        ? instance-names[instance-index]
        : "";

    in-out property <int> active-tab: 0;
    changed active-tab => {
        root.settings-open = root.active-tab >= 3;
        root.appearance-open = false;
        if root.active-tab == 4 { root.settings-section = 1; }

        root.page-start = InteractionMotion.clock;
    }
    property <float> design-scale: max(1, min(root.width / 1600px, root.height / 900px));
    property <length> shell-left: root.width < 1100px ? 214px : 402px;
    in-out property <int> settings-section: 0;
    changed appearance-open => { if root.appearance-open { root.settings-open = true; root.settings-section = 2; } }
    changed settings-section => { root.appearance-open = root.settings-section == 2 && root.settings-open; root.page-start = InteractionMotion.clock; }
    property <int> screen-index: settings-open || appearance-open ? 1 : 0;
    property <float> page-start: 0;
    out property <float> nav-position: pill.value;
    out property <float> page-phase: page-progress;
    changed screen-index => { root.page-start = InteractionMotion.clock; }
    property <float> page-progress: reduce-animations ? 1 : InteractionMotion.sample(0, 1, 0, max(0, InteractionMotion.clock - page-start));
    pure function entry(index: int) -> float {
        return root.reduce-animations ? 1 : InteractionMotion.sample(0, 1, 0, max(0, InteractionMotion.clock - root.page-start - min(index, 10) * 0.035));
    }
    property <bool> motion-reduced: reduce-animations;
    changed motion-reduced => { InteractionMotion.reduced = root.reduce-animations; root.page-start = InteractionMotion.clock - 1; }
    background: root.active-tab == 0 && root.selected-theme == "horizonte" ? #0c0a14 : @linear-gradient(135deg, ThemePalette.bg, ThemePalette.bg-end);
    if root.active-tab == 0 : Rectangle {x:0px;y:0px;width:100%;height:100%;
        Image {x:0px;y:0px;width:100%;height:100%;source:@image-url("shell/rework-ground.svg");image-fit:fill;}
        Rectangle {x:parent.width - 310px;y:parent.height - 350px;width:960px;height:960px;border-radius:480px;border-width:70px;border-color:#b491ef04;background:transparent;}
        Rectangle {x:parent.width - 240px;y:parent.height - 280px;width:820px;height:820px;border-radius:410px;border-width:1px;border-color:#c4a0ff20;background:transparent;}
    }
    Image { visible: root.active-tab != 0; width: parent.width; height: parent.height;
        source: ThemePalette.background-style == "dawn" ? @image-url("shell/dawn.png") : ThemePalette.background-style == "constellation" ? @image-url("shell/constellation.png") : @image-url("shell/galaxy.png");
        image-fit: cover;
    }
    Rectangle {
        width: 100%; height: 100%;
Rectangle {
    x:root.width < 1000px?24px:36px;y:0px;width:parent.width - 2*self.x;height:root.width < 1000px?80px:92px;
    Image {visible:root.startup-glyphs.length == 0 && !root.startup-overlay;x:0px;y:(parent.height - 26px)/2;width:root.width < 1000px?157px:205px;height:26px;source:ThemePalette.background-style == "dawn"?@image-url("branding/andromeda-dark.svg"):@image-url("branding/andromeda-light.svg");image-fit:contain;colorize:ThemePalette.text-color;}
    Rectangle {
        x:(parent.width - self.width)/2 + (root.width < 1000px?61px:20.7px);y:(parent.height - self.height)/2;width:root.width < 1000px?383.42px:444.22px;height:52px;
        border-radius:24px;border-width:1px;border-color:@linear-gradient(180deg,#ffffff3b,#ffffff20);background:@linear-gradient(110deg,#ffffff13,#b89cec0b);backdrop-blur:15px;inner-shadow-color:#ffffff0b;inner-shadow-offset-y:1px;drop-shadow-color:#00000033;drop-shadow-blur:30px;drop-shadow-offset-y:8px;
        pill := SpringValue {target:min(root.active-tab,3);}
        Rectangle {x:root.width < 1000px ? (pill.value<0.5?7px:pill.value<1.5?95.89px:pill.value<2.5?191.25px:278.34px) : (pill.value<0.5?7px:pill.value<1.5?110.72px:pill.value<2.5?221.45px:323.22px);y:7px;width:root.width < 1000px ? (root.active-tab==0?84.89px:root.active-tab==1?91.36px:root.active-tab==2?83.09px:98.08px) : (root.active-tab==0?99.72px:root.active-tab==1?106.73px:root.active-tab==2?97.77px:114px);height:38px;border-radius:17px;drop-shadow-color:#00000022;drop-shadow-blur:8px;drop-shadow-offset-y:2px;border-width:1px;border-color:#e3d6ff29;background:@linear-gradient(130deg,#d8c7ff30,#c0a5fa13);}
        for i in 4 : Rectangle {x:root.width < 1000px ? (i==0?7px:i==1?95.89px:i==2?191.25px:278.34px) : (i==0?7px:i==1?110.72px:i==2?221.45px:323.22px);y:7px;width:root.width < 1000px ? (i==0?84.89px:i==1?91.36px:i==2?83.09px:98.08px) : (i==0?99.72px:i==1?106.73px:i==2?97.77px:114px);height:38px;
            Image {x:root.width < 1000px?13px:19px;y:11px;width:16px;height:16px;source:i==0?@image-url("coolicons/play.svg"):i==1?@image-url("coolicons/box.svg"):i==2?@image-url("coolicons/puzzle.svg"):@image-url("coolicons/settings.svg");colorize:root.active-tab==i?ThemePalette.text-color:ThemePalette.muted;}
            Text {x:root.width < 1000px?38px:44px;y:0px;height:100%;text:i==0?"Home":i==1?"Library":i==2?"Mods":"Settings";vertical-alignment:center;font-family:ThemePalette.body-font;font-size:root.width<1000px?12px:13px;font-weight:500;color:root.active-tab==i?ThemePalette.text-color:ThemePalette.muted;}
            TouchArea {mouse-cursor:pointer;clicked=>{root.active-tab=i;if i==3 {root.settings-section=2;}}}
        }
    }
    Rectangle {x:parent.width - self.width;y:(parent.height - 35px)/2;width:root.width<1000px?35px:164px;height:35px;
        Rectangle {x:0px;y:0px;width:35px;height:35px;border-radius:12px;border-width:1px;border-color:#ffffff26;background:@linear-gradient(145deg,#9d8caf,#3d334a);
            Image {x:9px;y:9px;width:17px;height:17px;source:@image-url("coolicons/user.svg");colorize:#ded8eb;}
        }
        if root.width >= 1000px : Text {x:46px;y:0px;width:parent.width - 46px;height:100%;text:root.use-microsoft?"Microsoft":root.local-name;overflow:elide;vertical-alignment:center;font-family:ThemePalette.body-font;font-size:12px;color:ThemePalette.text-color;}
        TouchArea {mouse-cursor:pointer;clicked=>{root.active-tab=4;}}
    }
}

        if root.active-tab == 0 : ReworkHome {
            x:root.width<1000px?24px:36px; y:root.width<1000px?80px:92px;
            width:parent.width - 2*self.x; height:parent.height - self.y - 52px;
            reference-skin:root.selected-theme == "horizonte";
            theme-label:root.selected-theme == "horizonte" ? "HORIZONTE" : root.selected-theme == "alba" ? "ALBA" : root.selected-theme == "cartografo" ? "CARTOGRAFO" : root.selected-theme;
            names:root.instance-names; titles:root.profile-titles; details:root.profile-details; versions:root.profile-versions; loaders:root.profile-loaders; initials:root.profile-initials;
            selected:root.instance-index; busy:root.busy; status:root.launch-status;
            select(i)=>{root.instance-index=i;root.instance-selected(i);}
            play=>{root.launch-offline(root.local-name);}
            library=>{root.active-tab=1;}
            options=>{root.active-tab=1;}
            new-instance=>{root.active-tab=3;root.settings-section=0;}
        }

        // ---------------- play ----------------
        // `visible: false` still takes up space inside a layout, so the inactive
        // screen is removed with an `if` instead of being hidden.
        if root.active-tab == 1 : Rectangle {
            x: 36px; y: 160px; width: parent.width - 72px; height: parent.height - 196px;

            Rectangle { width: parent.width; height: parent.height; y: (1 - root.page-progress) * 24px; opacity: 0.35 + 0.65 * max(0, min(1, root.page-progress));
            HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 24px;

            // profiles
            GlassPanel {
                width: root.shell-left;

                VerticalLayout {
                    padding: 22px;
                    spacing: 12px;

                    Text {
                        font-family: ThemePalette.body-font;
                        text: @tr("INSTANCES");
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: root.c-muted;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        min-height: 120px;

                        VerticalLayout {
                            spacing: 4px;
                            for name[i] in root.instance-names : ProfileRow {
                                entered: root.entry(i);
                                label: name;
                                dark: root.dark-mode;
                                selected: i == root.instance-index;
                                clicked => {
                                    root.instance-index = i;
                                    root.instance-selected(i);
                                }
                            }
                        }
                    }

                    AppButton {
                        label: @tr("Manage profiles");
                        dark: root.dark-mode;
                        enabled: !root.busy;
                        clicked => {
                            root.active-tab = 3; root.settings-section = 0; root.appearance-open = false; root.settings-open = true;
                        }
                    }
                }
            }

            // Existing launch detail remains inside the reference shell in this checkpoint.
            GlassPanel {
                horizontal-stretch: 1;
                max-width: 100000px;

                VerticalLayout {
                    spacing: 6px;

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: root.current-profile;
                        font-family: ThemePalette.display-font;
                        opacity: ThemePalette.display-opacity;
                        font-size: 28px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        overflow: elide;
                        color: root.c-text;
                    }
                    Text {
                        font-family: ThemePalette.body-font;
                        text: @tr("Minecraft 1.21.11");
                        font-size: 12px;
                        horizontal-alignment: center;
                        color: root.c-muted;
                    }

                    Rectangle { height: 28px; }

                    HorizontalLayout {
                        alignment: center;
                        AppButton {
                            width: 420px;
                            height: 56px;
                            label: root.launch-busy
                                ? @tr("Working...")
                                : root.use-microsoft
                                    ? @tr("Play with Microsoft")
                                    : @tr("Play offline");
                            primary: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.launch-offline(root.local-name); }
                        }
                    }

                    Rectangle { height: 12px; }

                    Text {
                        font-family: ThemePalette.body-font;
                        text: root.launch-status;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        font-size: 12px;
                        color: root.c-muted;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
            }
                    }
}

        if root.active-tab == 2 : Rectangle {
            x: 36px; y: 160px; width: parent.width - 72px; height: parent.height - 196px;
            HorizontalLayout { width: 100%; height: 100%; spacing: 24px;
                GlassPanel { width: root.shell-left;
                    Text { x: 28px; y: 28px; text: "MODS"; font-size: 11px; letter-spacing: 2px; font-family: ThemePalette.value-font; color: ThemePalette.muted; }
                }
                GlassPanel { horizontal-stretch: 1;
                    VerticalLayout { padding: 40px; alignment: start; spacing: 20px;
                        Text { text: "Mods"; font-family: ThemePalette.display-font; font-size: 42px; color: ThemePalette.text-color; }
                        Text { text: "Mods are managed per profile. Select a profile with a mod loader in Play, then open Settings / Profiles to search, install, update or remove its mods."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 14px; color: ThemePalette.muted; }
                    }
                }
            }
        }

        // Grouped settings: one section list with values, one explanation/editor.
        if root.active-tab >= 3 : Rectangle {
            x: 36px; y: 160px; width: parent.width - 72px; height: parent.height - 196px;
            Rectangle { width: parent.width; height: parent.height; y: (1 - root.page-progress) * 18px; opacity: 0.35 + 0.65 * max(0, min(1, root.page-progress));
                HorizontalLayout {
                    width: 100%; height: 100%; spacing: 24px;
                    GlassPanel {
                        width: root.shell-left;
                        VerticalLayout { padding: 24px; spacing: 8px;
                            Text { text: root.active-tab == 4 ? "ACCOUNT" : "SETTINGS"; font-family: ThemePalette.value-font; font-size: 11px; font-weight: 700; letter-spacing: 2px; color: ThemePalette.muted; }
                            for title[i] in ["Profiles", "Account & player", "Appearance"] : SectionRow {
                                label: title;
                                value: i == 0 ? root.current-profile : i == 1 ? (root.use-microsoft ? "Microsoft for Play" : "Offline / " + root.local-name) : root.selected-theme + (root.reduce-animations ? " / reduced motion" : " / animated");
                                selected: root.settings-section == i;
                                entered: root.entry(i);
                                clicked => { root.settings-section = i; root.appearance-open = i == 2; }
                            }
                            Rectangle { vertical-stretch: 1; }

                            Text { text: "ANDROMEDA / VISUAL CHECKPOINT"; font-family: ThemePalette.body-font; font-size: 10px; color: ThemePalette.muted; }
                        }
                    }
                    GlassPanel {
                        horizontal-stretch: 1;
                        ScrollView { x: root.width < 1100px ? 22px : 44px; y: root.width < 1100px ? 22px : 40px; width: parent.width - (root.width < 1100px ? 44px : 88px); height: parent.height - (root.width < 1100px ? 44px : 80px);
                            VerticalLayout { spacing: 24px; alignment: start; padding-right: 12px;
                                Text { text: "SETTINGS / " + (root.settings-section == 0 ? "PROFILES" : root.settings-section == 1 ? "PLAYER" : "APPEARANCE"); font-family: ThemePalette.value-font; font-size: 11px; letter-spacing: 3px; color: ThemePalette.accent; }
                                Text { text: root.settings-section == 0 ? "Profiles" : root.settings-section == 1 ? "Account & player" : "Appearance"; font-family: ThemePalette.display-font; opacity: ThemePalette.display-opacity; font-size: root.width < 1000px ? 28px : 48px; font-weight: 800; color: ThemePalette.text-color; }
                                Text { text: root.settings-section == 0 ? "Create a profile or manage the one selected in Play. Each profile keeps its own game files." : root.settings-section == 1 ? "Choose your Play identity. Microsoft sign-in and the offline player name belong together here." : "Choose a theme and how much motion you want. The same layout and settings work across all themes."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.muted; }
                                if root.settings-section == 0 : VerticalLayout {
                                    vertical-stretch: 0; alignment: start; spacing: 12px;
                                    Text { text: "NEW PROFILE / COPY NAME"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    AppField { text <=> root.instance-name; placeholder: "Profile name"; enabled: !root.busy; }
                                    Text { text: "GAME VERSION"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    HorizontalLayout { spacing: 6px;
                                        for f[i] in ["Stable", "Snapshots", "Old", "All"] : AppButton {
                                            horizontal-stretch: 1; label: f; small: true; primary: root.version-filter == i; enabled: !root.busy;
                                            clicked => { root.version-filter = i; root.version-index = 0; root.version-refresh(i); }
                                        }
                                    }
                                    Rectangle { height: 168px; border-radius: 8px; background: ThemePalette.field; border-width: 1px; border-color: ThemePalette.border; clip: true;
                                        ScrollView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                                            VerticalLayout { spacing: 2px; alignment: start;
                                                for v[i] in root.version-choices : SectionRow {
                                                    label: v; value: ""; selected: root.version-index == i; entered: 1;
                                                    clicked => { root.version-index = i; root.version-picked(i); }
                                                }
                                                if root.version-choices.length == 0 : Text { text: "Loading versions..."; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.muted; }
                                            }
                                        }
                                    }
                                    Text { text: "LOADER (ONE PER PROFILE)"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    HorizontalLayout { spacing: 6px;
                                        for loader[i] in ["Vanilla", "Fabric", "Quilt", "Forge", "NeoForge", "LegacyFabric", "Babric", "Ornithe", "LiteLoader"] : AppButton {
                                            horizontal-stretch: 1; label: loader; small: true; primary: root.loader-index == i; enabled: !root.busy && (i == 0 || root.loader-available[i]);
                                            clicked => { root.loader-index = i; root.loader-version-index = 0; root.loader-picked(i); }
                                        }
                                    }
                                    if root.loader-index != 0 : VerticalLayout { spacing: 4px; alignment: start;
                                        Text { text: "LOADER BUILD"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                        Rectangle { height: 120px; border-radius: 8px; background: ThemePalette.field; border-width: 1px; border-color: ThemePalette.border; clip: true;
                                            ScrollView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                                                VerticalLayout { spacing: 2px; alignment: start;
                                                    for b[i] in root.loader-version-choices : SectionRow {
                                                        label: b; value: ""; selected: root.loader-version-index == i; entered: 1;
                                                        clicked => { root.loader-version-index = i; }
                                                    }
                                                    if root.loader-version-choices.length == 0 : Text { text: root.busy ? "Loading builds..." : "No builds published for this version."; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.muted; }
                                                }
                                            }
                                        }
                                    }
                                    AppButton { label: "Create profile"; primary: true; enabled: !root.busy && root.version-choices.length > 0 && (root.loader-index == 0 || root.loader-version-choices.length > 0); clicked => { root.manage-instance("createsel", root.instance-name); } }
                                    Rectangle { height: 1px; background: ThemePalette.border; }
                                    Text { text: "SELECTED IN PLAY"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    Text { text: root.current-profile; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 14px; font-weight: 600; color: ThemePalette.text-color; }
                                    Text { text: "Duplicate uses the name above. Trash is reversible. The default profile cannot be duplicated or trashed here."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; }
                                    HorizontalLayout { spacing: 6px;
                                        AppButton { horizontal-stretch: 1; label: "Duplicate"; small: true; enabled: !root.busy && root.instance-index > 0; clicked => { root.manage-instance("duplicate", root.instance-name); } }
                                        AppButton { horizontal-stretch: 1; label: root.trash-armed ? "Confirm trash" : "Move to trash"; small: true; danger: true; enabled: !root.busy && root.instance-index > 0; clicked => { root.manage-instance("trash", ""); } }
                                        AppButton { horizontal-stretch: 1; label: "Undo trash"; small: true; enabled: !root.busy && root.can-restore; clicked => { root.manage-instance("restore", ""); } }
                                    }
// --- Anchor 2: UI block, insert after the Duplicate/Trash row ---
    Rectangle { height: 1px; background: ThemePalette.border; }
    Text { text: "MODS (SELECTED IN PLAY)"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
    if !root.mod-supported : Text { text: "Mods need a profile with a mod loader."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.muted; }
    if root.mod-supported : VerticalLayout {
        vertical-stretch: 0; alignment: start; spacing: 8px;
        Rectangle { height: 140px; border-radius: 8px; background: ThemePalette.field; border-width: 1px; border-color: ThemePalette.border; clip: true;
            ScrollView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                VerticalLayout { spacing: 2px; alignment: start;
                    for m[i] in root.mod-rows : SectionRow {
                        label: m; value: root.mod-row-details[i]; selected: root.mod-index == i; entered: 1;
                        clicked => { root.mod-index = i; }
                    }
                    if root.mod-rows.length == 0 : Text { text: root.busy ? "Loading..." : "No managed mods yet."; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.muted; }
                }
            }
        }
        HorizontalLayout { spacing: 6px;
            AppButton { horizontal-stretch: 1; label: "On/Off"; small: true; enabled: !root.busy && root.mod-rows.length > 0; clicked => { root.mod-toggle(); } }
            AppButton { horizontal-stretch: 1; label: "Update"; small: true; enabled: !root.busy && root.mod-rows.length > 0; clicked => { root.mod-update(); } }
            AppButton { horizontal-stretch: 1; label: "Remove"; small: true; danger: true; enabled: !root.busy && root.mod-rows.length > 0; clicked => { root.mod-remove(); } }
        }
        HorizontalLayout { spacing: 6px;
            AppField { horizontal-stretch: 1; text <=> root.mod-query; placeholder: "Search Modrinth"; enabled: !root.busy; }
            AppButton { label: "Search"; small: true; enabled: !root.busy && root.mod-query != ""; clicked => { root.mods-search(); } }
        }
        Rectangle { height: 120px; border-radius: 8px; background: ThemePalette.field; border-width: 1px; border-color: ThemePalette.border; clip: true;
            ScrollView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                VerticalLayout { spacing: 2px; alignment: start;
                    for r[i] in root.mod-results : SectionRow {
                        label: r; value: root.mod-result-details[i]; selected: root.mod-result-index == i; entered: 1;
                        clicked => { root.mod-result-index = i; }
                    }
                    if root.mod-results.length == 0 : Text { text: "Search to see compatible mods."; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.muted; }
                }
            }
        }
        AppButton { label: "Install selected"; primary: true; enabled: !root.busy && root.mod-results.length > 0; clicked => { root.mod-install(); } }
        Text { text: root.mod-status; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; }
    }

                                }
                                if root.settings-section == 1 : VerticalLayout {
                                    vertical-stretch: 0; alignment: start; spacing: 12px;
                                    Text { text: "MICROSOFT ACCOUNT"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    Text { text: root.account-status; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.text-color; }
                                    HorizontalLayout { spacing: 6px;
                                        AppButton { horizontal-stretch: 1; label: "Sign in"; primary: !root.use-microsoft; enabled: !root.busy; clicked => { root.account-action("signin"); } }
                                        AppButton { horizontal-stretch: 1; label: "Cancel sign-in"; enabled: root.auth-busy; clicked => { root.account-action("cancel"); } }
                                        AppButton { horizontal-stretch: 1; label: "Sign out"; enabled: !root.busy; clicked => { root.account-action("signout"); } }
                                    }
                                    AppSwitch { label: "Use Microsoft for Play"; checked <=> root.use-microsoft; enabled: !root.busy; }
                                    Rectangle { height: 1px; background: ThemePalette.border; }
                                    Text { text: "OFFLINE PLAYER"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    AppField { text <=> root.local-name; placeholder: "Ingame name"; enabled: !root.busy; }
                                    Text { text: "Offline play is singleplayer only. Microsoft play verifies your Java entitlement. Switching identity does not delete your game profiles."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; }
                                }
                                if root.settings-section == 2 : VerticalLayout {
                                    vertical-stretch: 0; alignment: start; spacing: 10px;
                                    for choice[i] in root.theme-choices : ThemeRow {
                                        choice: choice; selected: choice.id == root.selected-theme; entered: root.entry(i);
                                        clicked => { root.theme-selected(choice.id); }
                                    }
                                    AppSwitch { label: "Reduce animations"; checked <=> root.reduce-animations; toggled => { root.settings-changed(); } }
                                    Text { text: root.theme-status; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 10px; color: ThemePalette.muted; }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }

    // Cover menu until its first complete frame, then reveal without a white flash.
    Rectangle { width: 100%; height: 100%; background: #080611; opacity: 1 - root.startup-reveal;
        Image { width: 100%; height: 100%; source: @image-url("../assets/startup/backdrop.png"); image-fit: fill; }
        TouchArea { enabled: root.startup-overlay; }
    }
    // Keep the same Path instances at the destination: no SVG/Path rasterization swap.
    if root.startup-glyphs.length > 0 : StartupLogo {
        property <float> dest-scale: root.startup-dest-width / 1120.24;
        x: (root.startup-overlay ? root.startup-x : root.startup-dest-x - 400.28 * self.dest-scale) * 1px;
        y: (root.startup-overlay ? root.startup-y : root.startup-dest-y + (28. - 75. * root.startup-dest-width / 836.) / 2. - 456.34 * self.dest-scale) * 1px;
        width: (root.startup-overlay ? root.startup-width : 1920. * self.dest-scale) * 1px; height: self.width * 1080 / 1920;
        glyphs: root.startup-glyphs; planet-x:480.96902125;planet-y:508.59999933;planet-size:160.76932338;
        occlude:false;ink:root.startup-overlay ? root.startup-ink : ThemePalette.text-color;
    }
}

