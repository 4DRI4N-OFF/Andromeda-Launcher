import { ScrollView } from "std-widgets.slint";

// JetBrains Mono is embedded at build time so the launcher looks the same on a
// machine that does not have it installed. Four static weights cover 400-800.
import "./fonts/JetBrainsMono-Regular.ttf";
import "./fonts/JetBrainsMono-Medium.ttf";
import "./fonts/JetBrainsMono-SemiBold.ttf";
import "./fonts/JetBrainsMono-Bold.ttf";

// Every control is drawn here instead of using the platform style: the launcher
// has its own dark/light switch, and the platform widgets follow the system
// theme, which made the fields look out of place in the opposite mode.

component AppButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> enabled: true;
    in property <bool> dark: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> small: false;
    callback clicked;

    height: small ? 30px : 38px;
    border-radius: 9px;
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.45;
    border-color: primary
        ? #7f78ff
        : danger
            ? (dark ? #5c2b3d : #ecc6d1)
            : (dark ? #243052 : #d9e0f0);
    background: primary
        ? (ta.pressed ? #5750d6 : ta.has-hover ? #7b74ff : #6a63f4)
        : danger
            ? (ta.has-hover ? (dark ? #2c1722 : #fbe9ee) : (dark ? #1d1119 : #fdf3f6))
            : (ta.has-hover ? (dark ? #18203a : #eef2fb) : (dark ? #121a30 : #ffffff));

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    Text {
        font-family: "JetBrains Mono";
        text: root.label;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        font-size: small ? 11.5px : 13px;
        font-weight: 600;
        color: primary ? #ffffff : danger ? (dark ? #ff9db1 : #a52b46) : (dark ? #cfd7f5 : #2b3a5e);
    }
}

// One line of text input. The width is set by the caller so the caret area always
// matches the card it lives in.
component AppField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;

    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    clip: true;
    opacity: enabled ? 1.0 : 0.5;
    background: dark ? #0a1120 : #f7f9fe;
    border-color: !enabled
        ? (dark ? #1e2947 : #e2e7f3)
        : field.has-focus
            ? #6a63f4
            : (dark ? #243052 : #d9e0f0);

    // TextInput has no placeholder in this Slint version, so the hint is drawn
    // behind the input and hidden as soon as there is text.
    Text {
        font-family: "JetBrains Mono";
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "";
        text: root.placeholder;
        font-size: 13px;
        color: dark ? #5f6a90 : #98a1bd;
    }

    field := TextInput {
        font-family: "JetBrains Mono";
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        enabled: root.enabled;
        text <=> root.text;
        vertical-alignment: center;
        font-size: 13px;
        color: dark ? #eef1ff : #0e1730;
    }
}

component AppSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;
    callback toggled;

    height: 26px;
    opacity: enabled ? 1.0 : 0.45;

    Text {
        font-family: "JetBrains Mono";
        x: 0px;
        y: 0px;
        width: root.width - 46px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 12.5px;
        color: dark ? #cfd7f5 : #33406a;
    }

    Rectangle {
        x: root.width - 38px;
        y: 3px;
        width: 38px;
        height: 21px;
        border-radius: 11px;
        background: root.checked ? #6a63f4 : (dark ? #243052 : #cfd7e8);

        Rectangle {
            x: root.checked ? 19px : 2px;
            y: 2px;
            width: 17px;
            height: 17px;
            border-radius: 9px;
            background: root.checked ? #ffffff : (dark ? #8b96bd : #ffffff);
        }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
}

// One row per instance. Selection is driven by the window's instance-index, so the
// highlighted row always matches what Play will launch.
component ProfileRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> dark: true;
    callback clicked;

    height: 42px;
    border-radius: 9px;
    border-width: 1px;
    border-color: selected ? (dark ? #3b47a0 : #b9c4ee) : transparent;
    background: selected
        ? (dark ? #1a2350 : #e9edfc)
        : (ta.has-hover ? (dark ? #131c33 : #f3f6fd) : transparent);
    clip: true;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        font-family: "JetBrains Mono";
        x: 14px;
        y: 0px;
        width: root.width - 26px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 12.5px;
        font-weight: root.selected ? 600 : 500;
        color: root.selected ? (root.dark ? #eef1ff : #0f1730) : (root.dark ? #b9c2e2 : #46507a);
    }
}

export component MainWindow inherits Window {
    title: @tr("Andromeda Launcher");
    icon: @image-url("logo-mark.png");
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 860px;
    min-height: 620px;

    in-out property <bool> reduce-animations;
    in-out property <bool> dark-mode: true;
    in-out property <bool> intro-visible: false;
    in property <image> intro-frame;
    in property <[string]> instance-names: ["Default profile (phase 2)"];
    in-out property <int> instance-index: 0;
    in-out property <string> instance-name: "New instance";
    in-out property <bool> trash-armed: false;
    in-out property <bool> can-restore: false;
    callback instance-selected(int);
    callback manage-instance(string, string);
    in-out property <bool> auth-busy: false;
    in-out property <bool> use-microsoft: false;
    in-out property <string> account-status: "Not signed in. Local offline profiles are still available.";
    callback account-action(string);
    callback settings-changed();
    callback launch-offline(string);
    in-out property <string> local-name: "Player";
    in-out property <bool> launch-busy: false;
    in-out property <string> launch-status: "Choose a profile, then Play. Installed files are verified before launch.";

    // Two screens: Play (default) and settings. The account, creation and
    // appearance controls live on the second one, which is what keeps Play calm.
    in-out property <bool> settings-open: false;

    // Theme tokens, driven by the launcher's own setting rather than the system theme.
    property <color> c-bg: dark-mode ? #070a14 : #f2f5fb;
    property <color> c-panel: dark-mode ? #0d1424 : #ffffff;
    property <color> c-border: dark-mode ? #1e2947 : #e2e7f3;
    property <color> c-text: dark-mode ? #eef1ff : #0e1730;
    property <color> c-muted: dark-mode ? #8d97c4 : #5c6585;
    property <bool> busy: launch-busy || auth-busy;
    // Never index the model blindly: an empty or stale model must not panic.
    property <string> current-profile: instance-index >= 0 && instance-index < instance-names.length
        ? instance-names[instance-index]
        : "";

    background: c-bg;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // ---------------- header ----------------
        HorizontalLayout {
            height: 46px;
            spacing: 12px;

            Image {
                width: 32px;
                height: 32px;
                source: @image-url("logo-mark.png");
                image-fit: contain;
            }

            Text {
                font-family: "JetBrains Mono";
                text: @tr("Andromeda");
                font-size: 18px;
                font-weight: 800;
                vertical-alignment: center;
                color: root.c-text;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 168px;
                height: 30px;
                border-radius: 15px;
                border-width: 1px;
                border-color: root.c-border;
                background: root.c-panel;

                Rectangle {
                    x: 12px;
                    y: 11px;
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.use-microsoft ? #57e2c8 : #5b678f;
                }
                Text {
                    font-family: "JetBrains Mono";
                    x: 26px;
                    y: 0px;
                    width: 130px;
                    height: parent.height;
                    vertical-alignment: center;
                    overflow: elide;
                    text: root.use-microsoft ? @tr("Microsoft account") : @tr("Offline profile");
                    font-size: 11.5px;
                    color: root.c-text;
                }
            }

            AppButton {
                width: 104px;
                dark: root.dark-mode;
                label: root.settings-open ? @tr("Back") : @tr("Settings");
                clicked => {
                    root.settings-open = !root.settings-open;
                }
            }
        }

        // ---------------- play ----------------
        // `visible: false` still takes up space inside a layout, so the inactive
        // screen is removed with an `if` instead of being hidden.
        if !root.settings-open : Rectangle {
            vertical-stretch: 1;

            HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 14px;

            // profiles
            Rectangle {
                width: 320px;
                border-radius: 14px;
                border-width: 1px;
                border-color: root.c-border;
                background: root.c-panel;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        font-family: "JetBrains Mono";
                        text: @tr("Profiles");
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: root.c-muted;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        min-height: 120px;

                        VerticalLayout {
                            spacing: 4px;
                            for name[i] in root.instance-names : ProfileRow {
                                label: name;
                                dark: root.dark-mode;
                                selected: i == root.instance-index;
                                clicked => {
                                    root.instance-index = i;
                                    root.instance-selected(i);
                                }
                            }
                        }
                    }

                    AppButton {
                        label: @tr("+ New profile");
                        dark: root.dark-mode;
                        enabled: !root.busy;
                        clicked => {
                            root.settings-open = true;
                        }
                    }
                }
            }

            // play: one action, no card border
            Rectangle {
                horizontal-stretch: 1;
                max-width: 100000px;

                VerticalLayout {
                    spacing: 6px;

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        font-family: "JetBrains Mono";
                        text: root.current-profile;
                        font-size: 28px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        overflow: elide;
                        color: root.c-text;
                    }
                    Text {
                        font-family: "JetBrains Mono";
                        text: @tr("Minecraft 1.21.11");
                        font-size: 12px;
                        horizontal-alignment: center;
                        color: root.c-muted;
                    }

                    Rectangle { height: 28px; }

                    HorizontalLayout {
                        alignment: center;
                        AppButton {
                            width: 420px;
                            height: 56px;
                            label: root.launch-busy
                                ? @tr("Working...")
                                : root.use-microsoft
                                    ? @tr("Play with Microsoft")
                                    : @tr("Play offline");
                            primary: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.launch-offline(root.local-name); }
                        }
                    }

                    Rectangle { height: 12px; }

                    Text {
                        font-family: "JetBrains Mono";
                        text: root.launch-status;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        font-size: 12px;
                        color: root.c-muted;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
            }
        }

        // ---------------- settings ----------------
        if root.settings-open : Rectangle {
            vertical-stretch: 1;

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: 14px;

                    Rectangle {
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: root.c-border;
                        background: root.c-panel;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;

                            Text {
                                font-family: "JetBrains Mono";
                                text: @tr("Microsoft account");
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0.6px;
                                color: root.c-muted;
                            }

                            Text {
                                font-family: "JetBrains Mono";
                                text: root.account-status;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: root.c-text;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                AppButton {
                                    width: 200px;
                                    label: @tr("Sign in");
                                    primary: !root.use-microsoft;
                                    dark: root.dark-mode;
                                    enabled: !root.busy;
                                    clicked => { root.account-action("signin"); }
                                }
                                AppButton {
                                    width: 140px;
                                    label: @tr("Cancel");
                                    dark: root.dark-mode;
                                    enabled: root.auth-busy;
                                    clicked => { root.account-action("cancel"); }
                                }
                                AppButton {
                                    width: 150px;
                                    label: @tr("Sign out");
                                    dark: root.dark-mode;
                                    enabled: !root.busy;
                                    clicked => { root.account-action("signout"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            AppSwitch {
                                width: 300px;
                                label: @tr("Use for Play");
                                checked <=> root.use-microsoft;
                                dark: root.dark-mode;
                                enabled: !root.busy;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: root.c-border;
                        background: root.c-panel;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;

                            Text {
                                font-family: "JetBrains Mono";
                                text: @tr("New profile");
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0.6px;
                                color: root.c-muted;
                            }

                            AppField {
                                width: 100%;
                                text <=> root.instance-name;
                                placeholder: @tr("Instance name");
                                dark: root.dark-mode;
                                enabled: !root.busy;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                AppButton {
                                    width: 100px;
                                    label: @tr("Vanilla");
                                    small: true;
                                    dark: root.dark-mode;
                                    enabled: !root.busy;
                                    clicked => { root.manage-instance("create", root.instance-name); }
                                }
                                AppButton {
                                    width: 100px;
                                    label: @tr("Fabric");
                                    small: true;
                                    dark: root.dark-mode;
                                    enabled: !root.busy;
                                    clicked => { root.manage-instance("createfabric", root.instance-name); }
                                }
                                AppButton {
                                    width: 100px;
                                    label: @tr("Quilt");
                                    small: true;
                                    dark: root.dark-mode;
                                    enabled: !root.busy;
                                    clicked => { root.manage-instance("createquilt", root.instance-name); }
                                }
                                AppButton {
                                    width: 100px;
                                    label: @tr("Forge");
                                    small: true;
                                    dark: root.dark-mode;
                                    enabled: !root.busy;
                                    clicked => { root.manage-instance("createforge", root.instance-name); }
                                }
                                AppButton {
                                    width: 100px;
                                    label: @tr("NeoForge");
                                    small: true;
                                    dark: root.dark-mode;
                                    enabled: !root.busy;
                                    clicked => { root.manage-instance("createneoforge", root.instance-name); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: root.c-border;
                        background: root.c-panel;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;

                            Text {
                                font-family: "JetBrains Mono";
                                text: @tr("Selected profile");
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0.6px;
                                color: root.c-muted;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                AppButton {
                                    width: 140px;
                                    label: @tr("Duplicate");
                                    dark: root.dark-mode;
                                    enabled: !root.busy && root.instance-index > 0;
                                    clicked => { root.manage-instance("duplicate", root.instance-name); }
                                }
                                AppButton {
                                    width: 160px;
                                    label: root.trash-armed ? @tr("Confirm trash") : @tr("Move to trash");
                                    danger: true;
                                    dark: root.dark-mode;
                                    enabled: !root.busy && root.instance-index > 0;
                                    clicked => { root.manage-instance("trash", ""); }
                                }
                                AppButton {
                                    width: 140px;
                                    label: @tr("Undo trash");
                                    dark: root.dark-mode;
                                    enabled: !root.busy && root.can-restore;
                                    clicked => { root.manage-instance("restore", ""); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            AppField {
                                width: 100%;
                                text <=> root.local-name;
                                placeholder: @tr("Ingame name");
                                dark: root.dark-mode;
                                enabled: !root.busy;
                            }

                            Text {
                                font-family: "JetBrains Mono";
                                text: @tr("Offline play is singleplayer only. Microsoft play verifies your Java entitlement.");
                                wrap: word-wrap;
                                font-size: 11px;
                                color: root.c-muted;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: root.c-border;
                        background: root.c-panel;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;

                            Text {
                                font-family: "JetBrains Mono";
                                text: @tr("Appearance");
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0.6px;
                                color: root.c-muted;
                            }

                            HorizontalLayout {
                                spacing: 24px;
                                AppSwitch {
                                    width: 220px;
                                    label: @tr("Reduce animations");
                                    checked <=> root.reduce-animations;
                                    dark: root.dark-mode;
                                    toggled => { root.settings-changed(); }
                                }
                                AppSwitch {
                                    width: 160px;
                                    label: @tr("Dark mode");
                                    checked <=> root.dark-mode;
                                    dark: root.dark-mode;
                                    toggled => { root.settings-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------- intro overlay ----------------
    Rectangle {
        visible: root.intro-visible;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #10121d;

        Image {
            width: 100%;
            height: 100%;
            source: root.intro-frame;
            image-fit: contain;
        }

        Text {
            font-family: "JetBrains Mono";
            x: 0px;
            y: parent.height - 48px;
            width: parent.width;
            text: @tr("Click to skip intro");
            horizontal-alignment: center;
            color: #9da2b8;
            font-size: 13px;
        }

        TouchArea {
            clicked => { root.intro-visible = false; }
        }
    }
}
