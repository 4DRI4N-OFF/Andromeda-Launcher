import { Switch, LineEdit, Button, ComboBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: @tr("Andromeda Launcher");
    preferred-width: 960px;
    preferred-height: 900px;
    in-out property <bool> reduce-animations;
    in-out property <bool> dark-mode: true;
    in-out property <bool> intro-visible: false;
    in property <image> intro-frame;
    in property <[string]> instance-names: ["Default profile (phase 2)"];
    in-out property <int> instance-index: 0;
    in-out property <string> instance-name: "New instance";
    in-out property <bool> trash-armed: false;
    in-out property <bool> can-restore: false;
    callback instance-selected(int);
    callback manage-instance(string, string);
    in-out property <bool> auth-busy: false;
    in-out property <bool> use-microsoft: false;
    in-out property <string> account-status: "Not signed in. Local offline profiles are still available.";
    callback account-action(string);
    callback settings-changed();
    callback launch-offline(string);
    in-out property <string> local-name: "Player";
    in-out property <bool> launch-busy: false;
    in-out property <string> launch-status: "Choose a profile, then Play. Installed files are verified before launch.";

    background: dark-mode ? #0b1020 : #f3f5fb;

    Rectangle {
        visible: !root.intro-visible;
        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            Text {
                text: @tr("Andromeda");
                font-size: 40px;
                font-weight: 800;
                color: root.dark-mode ? #e8ecff : #10142a;
            }
            Text {
                text: @tr("Play Minecraft with an offline or Microsoft profile");
                font-size: 16px;
                color: root.dark-mode ? #8d97c4 : #4a5280;
            }
            Text {
                text: @tr("Minecraft 1.21.11 - Vanilla or Fabric");
                font-size: 18px;
                color: root.dark-mode ? #e8ecff : #10142a;
            }
            ComboBox {
                model: root.instance-names;
                current-index <=> root.instance-index;
                enabled: !root.launch-busy && !root.auth-busy;
                selected(value) => { root.instance-selected(root.instance-index); }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.instance-name; placeholder-text: @tr("Instance name"); enabled: !root.launch-busy && !root.auth-busy; }
                Button { text: @tr("Create"); enabled: !root.launch-busy && !root.auth-busy; clicked => { root.manage-instance("create", root.instance-name); } }
                Button { text: @tr("Create Fabric 0.20.1"); enabled: !root.launch-busy && !root.auth-busy; clicked => { root.manage-instance("createfabric", root.instance-name); } }
                Button { text: @tr("Duplicate"); enabled: !root.launch-busy && !root.auth-busy && root.instance-index > 0; clicked => { root.manage-instance("duplicate", root.instance-name); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: root.trash-armed ? @tr("Confirm trash") : @tr("Move to trash"); enabled: !root.launch-busy && !root.auth-busy && root.instance-index > 0; clicked => { root.manage-instance("trash", ""); } }
                Button { text: @tr("Undo last trash"); enabled: !root.launch-busy && !root.auth-busy && root.can-restore; clicked => { root.manage-instance("restore", ""); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: @tr("Sign in with Microsoft"); enabled: !root.launch-busy && !root.auth-busy; clicked => { root.account-action("signin"); } }
                Button { text: @tr("Cancel sign-in"); enabled: root.auth-busy; clicked => { root.account-action("cancel"); } }
                Button { text: @tr("Sign out locally"); enabled: !root.launch-busy && !root.auth-busy; clicked => { root.account-action("signout"); } }
            }
            Text { text: root.account-status; wrap: word-wrap; color: root.dark-mode ? #b5bedf : #4a5280; font-size: 13px; }
            Switch { text: @tr("Use Microsoft account for Play"); checked <=> root.use-microsoft; enabled: !root.launch-busy && !root.auth-busy; }
            LineEdit {
                text <=> root.local-name;
                placeholder-text: @tr("Local name (1-16 letters, numbers or _)");
                enabled: !root.launch-busy && !root.auth-busy;
            }
            Button {
                text: root.launch-busy ? @tr("Working...") : root.use-microsoft ? @tr("Play with Microsoft") : @tr("Play offline");
                enabled: !root.launch-busy && !root.auth-busy;
                clicked => { root.launch-offline(root.local-name); }
            }
            Text {
                text: root.launch-status;
                wrap: word-wrap;
                color: root.dark-mode ? #b5bedf : #4a5280;
                font-size: 14px;
            }
            Text {
                text: @tr("Offline profiles are local singleplayer only. Microsoft play verifies your Minecraft Java entitlement.");
                wrap: word-wrap;
                color: root.dark-mode ? #8d97c4 : #4a5280;
                font-size: 12px;
            }

            Rectangle { vertical-stretch: 1; }
            Switch {
                text: @tr("Reduce animations");
                checked <=> root.reduce-animations;
                toggled => { root.settings-changed(); }
            }
            Switch {
                text: @tr("Dark mode");
                checked <=> root.dark-mode;
                toggled => { root.settings-changed(); }
            }
        }
    }
    Rectangle {
        visible: root.intro-visible;
        background: #10121d;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.intro-frame;
            image-fit: contain;
        }
        Text {
            x: 0px;
            y: parent.height - 48px;
            width: parent.width;
            text: @tr("Click to skip intro");
            horizontal-alignment: center;
            color: #9da2b8;
            font-size: 13px;
        }
        TouchArea { clicked => { root.intro-visible = false; } }
    }
}
