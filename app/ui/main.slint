import { ScrollView } from "std-widgets.slint";

// Every control is drawn here instead of using the platform style: the launcher
// has its own dark/light switch, and the platform widgets follow the system
// theme, which made the fields look out of place in the opposite mode.

component AppButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> enabled: true;
    in property <bool> dark: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> small: false;
    callback clicked;

    height: small ? 30px : 38px;
    border-radius: 8px;
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.45;
    border-color: primary
        ? #7f78ff
        : danger
            ? (dark ? #5c2b3d : #ecc6d1)
            : (dark ? #243052 : #d9e0f0);
    background: primary
        ? (ta.pressed ? #5750d6 : ta.has-hover ? #7b74ff : #6a63f4)
        : danger
            ? (ta.has-hover ? (dark ? #2c1722 : #fbe9ee) : (dark ? #1d1119 : #fdf3f6))
            : (ta.has-hover ? (dark ? #18203a : #eef2fb) : (dark ? #121a30 : #ffffff));

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    Text {
        text: root.label;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        font-size: small ? 11.5px : 13px;
        font-weight: 600;
        color: primary ? #ffffff : danger ? (dark ? #ff9db1 : #a52b46) : (dark ? #cfd7f5 : #2b3a5e);
    }
}

// One line of text input. The width is set by the caller so the caret area always
// matches the card it lives in.
component AppField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;

    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    clip: true;
    opacity: enabled ? 1.0 : 0.5;
    background: dark ? #0a1120 : #f7f9fe;
    border-color: !enabled
        ? (dark ? #1e2947 : #e2e7f3)
        : field.has-focus
            ? #6a63f4
            : (dark ? #243052 : #d9e0f0);

    // TextInput has no placeholder in this Slint version, so the hint is drawn
    // behind the input and hidden as soon as there is text.
    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "";
        text: root.placeholder;
        font-size: 13px;
        color: dark ? #5f6a90 : #98a1bd;
    }

    field := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        enabled: root.enabled;
        text <=> root.text;
        vertical-alignment: center;
        font-size: 13px;
        color: dark ? #eef1ff : #0e1730;
    }
}

component AppSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;
    callback toggled;

    height: 26px;
    opacity: enabled ? 1.0 : 0.45;

    Text {
        x: 0px;
        y: 0px;
        width: root.width - 46px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 12.5px;
        color: dark ? #cfd7f5 : #33406a;
    }

    Rectangle {
        x: root.width - 38px;
        y: 3px;
        width: 38px;
        height: 21px;
        border-radius: 11px;
        background: root.checked ? #6a63f4 : (dark ? #243052 : #cfd7e8);

        Rectangle {
            x: root.checked ? 19px : 2px;
            y: 2px;
            width: 17px;
            height: 17px;
            border-radius: 9px;
            background: root.checked ? #ffffff : (dark ? #8b96bd : #ffffff);
        }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
}

// One row per instance. Selection is driven by the window's instance-index, so the
// highlighted row always matches what Play will launch.
component ProfileRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> dark: true;
    callback clicked;

    height: 44px;
    border-radius: 9px;
    border-width: 1px;
    border-color: selected ? (dark ? #3b47a0 : #b9c4ee) : transparent;
    background: selected
        ? (dark ? #1a2350 : #e9edfc)
        : (ta.has-hover ? (dark ? #131c33 : #f3f6fd) : transparent);
    clip: true;

    Rectangle {
        visible: root.selected;
        x: 0px;
        y: 10px;
        width: 3px;
        height: root.height - 20px;
        border-radius: 2px;
        background: #8b8dff;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        x: 14px;
        y: 0px;
        width: root.width - 26px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 13px;
        font-weight: root.selected ? 600 : 500;
        color: root.selected ? (root.dark ? #eef1ff : #0f1730) : (root.dark ? #b9c2e2 : #46507a);
    }
}

export component MainWindow inherits Window {
    title: @tr("Andromeda Launcher");
    preferred-width: 1040px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 700px;

    in-out property <bool> reduce-animations;
    in-out property <bool> dark-mode: true;
    in-out property <bool> intro-visible: false;
    in property <image> intro-frame;
    in property <[string]> instance-names: ["Default profile (phase 2)"];
    in-out property <int> instance-index: 0;
    in-out property <string> instance-name: "New instance";
    in-out property <bool> trash-armed: false;
    in-out property <bool> can-restore: false;
    callback instance-selected(int);
    callback manage-instance(string, string);
    in-out property <bool> auth-busy: false;
    in-out property <bool> use-microsoft: false;
    in-out property <string> account-status: "Not signed in. Local offline profiles are still available.";
    callback account-action(string);
    callback settings-changed();
    callback launch-offline(string);
    in-out property <string> local-name: "Player";
    in-out property <bool> launch-busy: false;
    in-out property <string> launch-status: "Choose a profile, then Play. Installed files are verified before launch.";

    // Theme tokens, driven by the launcher's own setting rather than the system theme.
    property <color> c-bg: dark-mode ? #070a14 : #f2f5fb;
    property <color> c-panel: dark-mode ? #0d1424 : #ffffff;
    property <color> c-border: dark-mode ? #1e2947 : #e2e7f3;
    property <color> c-text: dark-mode ? #eef1ff : #0e1730;
    property <color> c-muted: dark-mode ? #8d97c4 : #5c6585;
    property <bool> busy: launch-busy || auth-busy;
    // Never index the model blindly: an empty or stale model must not panic.
    property <string> current-profile: instance-index >= 0 && instance-index < instance-names.length
        ? instance-names[instance-index]
        : "";

    background: c-bg;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // ---------------- header ----------------
        HorizontalLayout {
            height: 54px;
            spacing: 12px;

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: @linear-gradient(160deg, #57e2c8 0%, #6a63f4 55%, #b06bff 100%);

                Rectangle {
                    x: 10px;
                    y: 10px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.c-bg;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: @tr("Andromeda");
                    font-size: 19px;
                    font-weight: 800;
                    color: root.c-text;
                }
                Text {
                    text: @tr("Minecraft 1.21.11 - Vanilla, Fabric, Quilt, Forge or NeoForge");
                    font-size: 11.5px;
                    color: root.c-muted;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 168px;
                height: 30px;
                border-radius: 15px;
                border-width: 1px;
                border-color: root.c-border;
                background: root.c-panel;

                Rectangle {
                    x: 12px;
                    y: 11px;
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.use-microsoft ? #57e2c8 : #5b678f;
                }
                Text {
                    x: 26px;
                    y: 0px;
                    width: 130px;
                    height: parent.height;
                    vertical-alignment: center;
                    overflow: elide;
                    text: root.use-microsoft ? @tr("Microsoft account") : @tr("Offline profile");
                    font-size: 12px;
                    color: root.c-text;
                }
            }
        }

        // ---------------- body ----------------
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            // ---------- profiles ----------
            Rectangle {
                width: 316px;
                border-radius: 14px;
                border-width: 1px;
                border-color: root.c-border;
                background: root.c-panel;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        text: @tr("Profiles");
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: root.c-muted;
                    }

                    ScrollView {
                        min-height: 96px;
                        max-height: 320px;

                        VerticalLayout {
                            spacing: 6px;
                            for name[i] in root.instance-names : ProfileRow {
                                label: name;
                                dark: root.dark-mode;
                                selected: i == root.instance-index;
                                clicked => {
                                    root.instance-index = i;
                                    root.instance-selected(i);
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: root.c-border;
                    }

                    AppField {
                        width: 100%;
                        text <=> root.instance-name;
                        placeholder: @tr("New instance name");
                        dark: root.dark-mode;
                        enabled: !root.busy;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            label: @tr("Create");
                            primary: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.manage-instance("create", root.instance-name); }
                        }
                        AppButton {
                            label: @tr("Duplicate");
                            dark: root.dark-mode;
                            enabled: !root.busy && root.instance-index > 0;
                            clicked => { root.manage-instance("duplicate", root.instance-name); }
                        }
                    }

                    Text {
                        text: @tr("Create with a loader");
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: root.c-muted;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            label: @tr("Fabric 0.20.1");
                            small: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.manage-instance("createfabric", root.instance-name); }
                        }
                        AppButton {
                            label: @tr("Quilt 0.30.2");
                            small: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.manage-instance("createquilt", root.instance-name); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            label: @tr("Forge 61.2.5");
                            small: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.manage-instance("createforge", root.instance-name); }
                        }
                        AppButton {
                            label: @tr("NeoForge 21.11.48");
                            small: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.manage-instance("createneoforge", root.instance-name); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Rectangle {
                        height: 1px;
                        background: root.c-border;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            label: root.trash-armed ? @tr("Confirm trash") : @tr("Move to trash");
                            danger: true;
                            dark: root.dark-mode;
                            enabled: !root.busy && root.instance-index > 0;
                            clicked => { root.manage-instance("trash", ""); }
                        }
                        AppButton {
                            label: @tr("Undo trash");
                            dark: root.dark-mode;
                            enabled: !root.busy && root.can-restore;
                            clicked => { root.manage-instance("restore", ""); }
                        }
                    }
                }
            }

            // ---------- main ----------
            // The wrapper, not a nested layout, carries the stretch factor, and the
            // raised max-width is required: a Rectangle that hosts a layout reports
            // its preferred width as its maximum, so stretch alone was ignored and
            // the column stayed at content width with dead space to its right.
            Rectangle {
                horizontal-stretch: 1;
                max-width: 100000px;

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 14px;

                Rectangle {
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.c-border;
                    background: root.c-panel;

                    VerticalLayout {
                        padding: 22px;
                        spacing: 6px;

                        Text {
                            text: root.launch-busy ? @tr("Working...") : @tr("Ready to play");
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            color: root.launch-busy ? #ffd479 : root.c-muted;
                        }
                        Text {
                            text: root.current-profile;
                            font-size: 24px;
                            font-weight: 800;
                            overflow: elide;
                            color: root.c-text;
                        }

                        Rectangle { height: 12px; }

                        AppButton {
                            label: root.launch-busy
                                ? @tr("Working...")
                                : root.use-microsoft
                                    ? @tr("Play with Microsoft")
                                    : @tr("Play offline");
                            primary: true;
                            dark: root.dark-mode;
                            height: 52px;
                            enabled: !root.busy;
                            clicked => { root.launch-offline(root.local-name); }
                        }

                        Rectangle { height: 4px; }

                        Text {
                            text: root.launch-status;
                            wrap: word-wrap;
                            font-size: 12.5px;
                            color: root.c-muted;
                        }
                    }
                }

                Rectangle {
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.c-border;
                    background: root.c-panel;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        Text {
                            text: @tr("Microsoft account");
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            color: root.c-muted;
                        }
                        Text {
                            text: root.account-status;
                            wrap: word-wrap;
                            font-size: 12.5px;
                            color: root.c-text;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            AppButton {
                                label: @tr("Sign in with Microsoft");
                                primary: !root.use-microsoft;
                                dark: root.dark-mode;
                                enabled: !root.busy;
                                clicked => { root.account-action("signin"); }
                            }
                            AppButton {
                                label: @tr("Cancel sign-in");
                                dark: root.dark-mode;
                                enabled: root.auth-busy;
                                clicked => { root.account-action("cancel"); }
                            }
                            AppButton {
                                label: @tr("Sign out locally");
                                dark: root.dark-mode;
                                enabled: !root.busy;
                                clicked => { root.account-action("signout"); }
                            }
                        }

                        AppSwitch {
                            width: 250px;
                            label: @tr("Use Microsoft account for Play");
                            checked <=> root.use-microsoft;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                        }
                    }
                }

                Rectangle {
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.c-border;
                    background: root.c-panel;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 8px;

                        Text {
                            text: @tr("Offline name");
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            color: root.c-muted;
                        }
                        AppField {
                            width: 360px;
                            text <=> root.local-name;
                            placeholder: @tr("Local name (1-16 letters, numbers or _)");
                            dark: root.dark-mode;
                            enabled: !root.busy;
                        }
                        Text {
                            text: @tr("Singleplayer only. Microsoft play verifies your Minecraft Java entitlement.");
                            wrap: word-wrap;
                            font-size: 11.5px;
                            color: root.c-muted;
                        }
                    }
                }
                }
            }
        }

        // ---------------- footer ----------------
        HorizontalLayout {
            height: 30px;
            spacing: 18px;

            AppSwitch {
                width: 168px;
                label: @tr("Reduce animations");
                checked <=> root.reduce-animations;
                dark: root.dark-mode;
                toggled => { root.settings-changed(); }
            }
            AppSwitch {
                width: 118px;
                label: @tr("Dark mode");
                checked <=> root.dark-mode;
                dark: root.dark-mode;
                toggled => { root.settings-changed(); }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: @tr("Private development build");
                font-size: 11px;
                color: root.c-muted;
                vertical-alignment: center;
            }
        }
    }

    // ---------------- intro overlay ----------------
    Rectangle {
        visible: root.intro-visible;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #10121d;

        Image {
            width: 100%;
            height: 100%;
            source: root.intro-frame;
            image-fit: contain;
        }

        Text {
            x: 0px;
            y: parent.height - 48px;
            width: parent.width;
            text: @tr("Click to skip intro");
            horizontal-alignment: center;
            color: #9da2b8;
            font-size: 13px;
        }

        TouchArea {
            clicked => { root.intro-visible = false; }
        }
    }
}
