import { ScrollView } from "std-widgets.slint";

// JetBrains Mono is embedded at build time so the launcher looks the same on a
// machine that does not have it installed. Four static weights cover 400-800.
import "./fonts/JetBrainsMono-Regular.ttf";
import "./fonts/JetBrainsMono-Medium.ttf";
import "./fonts/JetBrainsMono-SemiBold.ttf";
import "./fonts/JetBrainsMono-Bold.ttf";

import "./fonts/inter.ttf";
import "./fonts/unbounded.ttf";
import "./fonts/fraunces.ttf";
import "./fonts/sora.ttf";

export struct ThemeChoice {
    id: string, name: string, description: string,
    background: color, background-end: color, accent: color, accent-end: color,
    text-color: color, display-font: string,
}

export global ThemePalette {
    in-out property <bool> reduce-motion: false;
    in-out property <color> bg: #0a0618;
    in-out property <color> bg-end: #1c0f38;
    in-out property <color> panel: #221735e8;
    in-out property <color> panel-light: #36264de8;
    in-out property <color> border: #ffffff29;
    in-out property <color> text-color: #f4effd;
    in-out property <color> muted: #b9adc9;
    in-out property <color> accent: #ffc37a;
    in-out property <color> accent-end: #ff8a4d;
    in-out property <color> nav-accent: #ffc37a;
    in-out property <color> list-accent: #ffc37a;
    in-out property <color> on-accent: #27170c;
    in-out property <color> field: #171025;
    in-out property <color> danger: #ff9db1;
    in-out property <string> body-font: "Inter";
    in-out property <string> display-font: "Unbounded";
    in-out property <string> value-font: "Inter";
    in-out property <string> background-style: "galaxy";
    in-out property <float> selection-scale: 1;
    in-out property <float> display-opacity: 1;

}

// Critically bounded layout boxes, with physical response inside each box.
export global InteractionMotion {
    in-out property <float> clock: 0;
    in-out property <bool> reduced: false;
    pure callback sample(float, float, float, float) -> float;
    pure callback velocity(float, float, float, float) -> float;
}
component SpringValue inherits Rectangle {
    width: 0px; height: 0px;
    in property <float> target: 0;
    property <float> origin: 0;
    property <float> goal: 0;
    property <float> initial-speed: 0;
    property <float> began: 0;
    property <bool> reduced: InteractionMotion.reduced;
    out property <float> value: reduced ? target : InteractionMotion.sample(origin, goal, initial-speed, max(0, InteractionMotion.clock - began));
    property <float> speed: reduced ? 0 : InteractionMotion.velocity(origin, goal, initial-speed, max(0, InteractionMotion.clock - began));
    changed target => {
        // Read the old trajectory before retargeting, preserving position/velocity.
        let current-value = root.value;
        let current-speed = root.speed;
        root.origin = current-value;
        root.initial-speed = current-speed;
        root.goal = root.target;
        root.began = InteractionMotion.clock;
    }
    changed reduced => {
        if root.reduced { root.origin = root.target; root.goal = root.target; root.initial-speed = 0; root.began = InteractionMotion.clock; }
    }
}

// Every control is drawn here instead of using the platform style: the launcher
// has its own dark/light switch, and the platform widgets follow the system
// theme, which made the fields look out of place in the opposite mode.

component AppButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> enabled: true;
    in property <bool> dark: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> small: false;
    callback clicked;

    height: small ? 30px : 38px;
    clip: true;
    opacity: enabled ? 1.0 : 0.45;
    press := SpringValue { target: ta.pressed && root.enabled ? 1 : 0; }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(parent.width, (parent.width - 2px) * (1 - 0.035 * press.value));
        height: min(parent.height, (parent.height - 2px) * (1 - 0.09 * press.value));
    border-radius: 9px;
    border-width: 1px;

    border-color: primary
        ? ThemePalette.accent
        : danger
            ? ThemePalette.border
            : ThemePalette.border;
    background: primary
        ? (ta.pressed ? ThemePalette.accent-end : ta.has-hover ? ThemePalette.accent : ThemePalette.accent)
        : danger
            ? (ta.has-hover ? ThemePalette.panel-light : ThemePalette.field)
            : (ta.has-hover ? ThemePalette.panel-light : ThemePalette.field);

    Text {
        font-family: ThemePalette.body-font;
        text: root.label;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        font-size: small ? 11.5px : 13px;
        font-weight: 600;
        color: primary ? ThemePalette.on-accent : danger ? ThemePalette.danger : ThemePalette.text-color;
    }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }


}

// One line of text input. The width is set by the caller so the caret area always
// matches the card it lives in.
component AppField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;

    focus-motion := SpringValue { target: field.has-focus ? 1 : 0; }
    height: 34px;
    border-radius: 8px;
    border-width: 1px + min(1, max(0, focus-motion.value)) * 1px;
    clip: true;
    opacity: enabled ? 1.0 : 0.5;
    background: ThemePalette.field;
    border-color: !enabled
        ? ThemePalette.border
        : field.has-focus
            ? ThemePalette.accent
            : ThemePalette.border;

    // TextInput has no placeholder in this Slint version, so the hint is drawn
    // behind the input and hidden as soon as there is text.
    Text {
        font-family: ThemePalette.body-font;
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "";
        text: root.placeholder;
        font-size: 13px;
        color: ThemePalette.muted;
    }

    field := TextInput {
        font-family: ThemePalette.body-font;
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        enabled: root.enabled;
        text <=> root.text;
        vertical-alignment: center;
        font-size: 13px;
        color: ThemePalette.text-color;
    }
}

component AppSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> dark: true;
    in-out property <bool> enabled: true;
    callback toggled;

    knob := SpringValue { target: root.checked ? 1 : 0; }
    height: 26px;
    opacity: enabled ? 1.0 : 0.45;

    Text {
        font-family: ThemePalette.body-font;
        x: 0px;
        y: 0px;
        width: root.width - 46px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 12.5px;
        color: ThemePalette.text-color;
    }

    Rectangle {
        x: root.width - 38px;
        y: 3px;
        width: 38px;
        height: 21px;
        border-radius: 11px;
        background: root.checked ? ThemePalette.accent : ThemePalette.border;

        Rectangle {
            x: 2px + min(1.08, max(-0.08, knob.value)) * 17px;
            y: 2px;
            width: 17px;
            height: 17px;
            border-radius: 9px;
            background: root.checked ? #ffffff : ThemePalette.muted;
        }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
}

// One row per instance. Selection is driven by the window's instance-index, so the
// highlighted row always matches what Play will launch.
component ProfileRow inherits Rectangle {
    in property <float> entered: 1;
    press := SpringValue { target: ta.pressed ? 1 : 0; }
    opacity: max(0, min(1, entered));
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> dark: true;
    callback clicked;

    height: 42px;
    border-radius: 9px;
    border-width: 1px;
    border-color: selected ? ThemePalette.list-accent : transparent;
    background: selected
        ? ThemePalette.panel-light
        : (ta.has-hover ? ThemePalette.panel-light : transparent);
    clip: true;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        font-family: ThemePalette.body-font;
        x: 14px + (1 - root.entered) * 22px + press.value * 3px;
        y: press.value * 1px;
        width: root.width - 26px;
        height: root.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.label;
        font-size: 12.5px;
        font-weight: root.selected ? 600 : 500;
        color: ThemePalette.text-color;
    }
}

component SectionRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected;
    in property <float> entered: 1;
    callback clicked;
    height: 76px; border-radius: 12px; clip: true;
    background: selected ? ThemePalette.panel-light : hit.has-hover ? ThemePalette.field : transparent;
    border-width: 1px; border-color: selected ? ThemePalette.nav-accent : transparent;
    opacity: min(1, max(0, entered));
    press := SpringValue { target: hit.pressed ? 1 : 0; }
    VerticalLayout { padding-left: 12px + press.value * 2px; padding-right: 12px; padding-top: 12px; padding-bottom: 12px; spacing: 6px;
        Text { text: root.label; font-family: ThemePalette.body-font; font-size: 13px; font-weight: 700; color: ThemePalette.text-color; }
        Text { text: root.value; overflow: elide; font-family: ThemePalette.body-font; font-size: 10px; color: ThemePalette.muted; }
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
component ThemeRow inherits Rectangle {
    in property <ThemeChoice> choice;
    in property <bool> selected;
    in property <float> entered: 1;
    callback clicked;
    height: 82px; clip: true;
    opacity: max(0,min(1,entered));
    press := SpringValue { target: hit.pressed ? 1 : 0; }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 + (1 - root.entered) * 12px;
        width: min(parent.width - 2px, (parent.width - 4px - press.value * 4px) * (root.selected ? ThemePalette.selection-scale : 1));
        height: min(parent.height - 2px, (parent.height - 4px) * (root.selected ? ThemePalette.selection-scale : 1));
        border-radius: 14px; border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? ThemePalette.accent : ThemePalette.border;
        background: ThemePalette.field;
        Rectangle { x: 12px; y: 14px; width: 42px; height: 44px; border-radius: 9px; background: root.choice.background;
            Rectangle { x: 6px; y: 28px; width: 30px; height: 8px; border-radius: 4px; background: @linear-gradient(90deg, root.choice.accent, root.choice.accent-end); }
        }
        Text { x: 66px; y: 12px; width: parent.width - 146px; text: root.choice.name; font-family: root.choice.display-font; font-size: 15px; font-weight: 700; color: ThemePalette.text-color; overflow: elide; }
        Text { x: 66px; y: 38px; width: parent.width - 82px; text: root.choice.description; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; wrap: word-wrap; }
        Text { x: parent.width - 72px; y: 15px; width: 60px; text: root.selected ? "APPLIED" : "APPLY"; horizontal-alignment: right; font-family: ThemePalette.body-font; font-size: 9px; font-weight: 700; color: root.selected ? ThemePalette.accent : ThemePalette.muted; }
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    title: @tr("Andromeda Launcher");
    icon: @image-url("logo-mark.png");
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 860px;
    min-height: 620px;

    in-out property <bool> reduce-animations;
    in-out property <bool> dark-mode: true;
    in-out property <bool> intro-visible: false;
    in property <image> intro-frame;
    in property <[string]> instance-names: ["Default profile (phase 2)"];
    in-out property <int> instance-index: 0;
    in-out property <string> instance-name: "New instance";
    in-out property <bool> trash-armed: false;
    in-out property <bool> can-restore: false;
    callback instance-selected(int);
    callback manage-instance(string, string);
    in-out property <bool> auth-busy: false;
    in-out property <bool> use-microsoft: false;
    in-out property <string> account-status: "Not signed in. Local offline profiles are still available.";
    callback account-action(string);
    callback settings-changed();
    callback launch-offline(string);
    in-out property <string> local-name: "Player";
    in-out property <bool> launch-busy: false;
    in-out property <string> launch-status: "Choose a profile, then Play. Installed files are verified before launch.";

    // Two screens: Play (default) and settings. The account, creation and
    // appearance controls live on the second one, which is what keeps Play calm.
    in-out property <bool> settings-open: false;

    in-out property <bool> appearance-open: false;
    in-out property <string> selected-theme: "horizonte";
    in property <[ThemeChoice]> theme-choices;
    in property <string> theme-status;
    callback theme-selected(string);
    property <color> c-bg: ThemePalette.bg;
    property <color> c-panel: ThemePalette.panel;
    property <color> c-border: ThemePalette.border;
    property <color> c-text: ThemePalette.text-color;
    property <color> c-muted: ThemePalette.muted;
    property <bool> busy: launch-busy || auth-busy;
    // Never index the model blindly: an empty or stale model must not panic.
    property <string> current-profile: instance-index >= 0 && instance-index < instance-names.length
        ? instance-names[instance-index]
        : "";

    in-out property <int> settings-section: 0;
    changed appearance-open => { if root.appearance-open { root.settings-open = true; root.settings-section = 2; } }
    changed settings-section => { root.appearance-open = root.settings-section == 2 && root.settings-open; root.page-start = InteractionMotion.clock; }
    property <int> screen-index: settings-open || appearance-open ? 1 : 0;
    property <float> page-start: 0;
    out property <float> nav-position: pill.value;
    out property <float> page-phase: page-progress;
    changed screen-index => { root.page-start = InteractionMotion.clock; }
    property <float> page-progress: reduce-animations ? 1 : InteractionMotion.sample(0, 1, 0, max(0, InteractionMotion.clock - page-start));
    pure function entry(index: int) -> float {
        return root.reduce-animations ? 1 : InteractionMotion.sample(0, 1, 0, max(0, InteractionMotion.clock - root.page-start - min(index, 10) * 0.035));
    }
    property <bool> motion-reduced: reduce-animations;
    changed motion-reduced => { InteractionMotion.reduced = root.reduce-animations; root.page-start = InteractionMotion.clock - 1; }
    background: @linear-gradient(135deg, ThemePalette.bg, ThemePalette.bg-end);
    // Decorative geometry is shared and never changes hit targets.
    for star[i] in [0.07, 0.17, 0.28, 0.39, 0.53, 0.66, 0.78, 0.91] : Rectangle {
        x: root.width * star; y: root.height * (0.08 + mod(i * 0.137, 0.85));
        width: ThemePalette.background-style == "dawn" ? 48px : 2px;
        height: self.width; border-radius: self.width / 2;
        border-width: ThemePalette.background-style == "dawn" ? 1px : 0px;
        border-color: ThemePalette.accent;
        background: ThemePalette.background-style == "dawn" ? transparent : ThemePalette.accent;
        opacity: ThemePalette.background-style == "dawn" ? 0.08 : 0.3;
    }
    VerticalLayout {
        padding: 28px;
        spacing: 18px;

        // ---------------- header ----------------
        HorizontalLayout {
            height: 46px;
            spacing: 12px;

            Image {
                width: 32px;
                height: 32px;
                source: @image-url("logo-mark.png");
                image-fit: contain;
            }

            Text {
                font-family: ThemePalette.body-font;
                text: @tr("Andromeda");
                font-size: 18px;
                font-weight: 800;
                vertical-alignment: center;
                color: root.c-text;
            }

            Rectangle {
                width: 154px; height: 34px;
                border-radius: 17px; background: ThemePalette.field;
                pill := SpringValue { target: root.screen-index; }
                Rectangle { x: 3px + max(-0.025, min(1.025, pill.value)) * 74px; y: 3px; width: 74px; height: 28px; border-radius: 14px; background: ThemePalette.nav-accent; }
                for title[i] in ["Play", "Settings"] : Rectangle {
                    x: 3px + i * 74px; width: 74px; height: 34px;
                    Text { width: 100%; height: 100%; text: title; font-family: ThemePalette.body-font; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; color: abs(pill.value - i) < 0.4 ? ThemePalette.on-accent : ThemePalette.text-color; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.settings-open = i != 0; root.appearance-open = i != 0 && root.settings-section == 2; } }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 168px;
                height: 30px;
                border-radius: 15px;
                border-width: 1px;
                border-color: root.c-border;
                background: root.c-panel;

                Rectangle {
                    x: 12px;
                    y: 11px;
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.use-microsoft ? #57e2c8 : #5b678f;
                }
                Text {
                    font-family: ThemePalette.body-font;
                    x: 26px;
                    y: 0px;
                    width: 130px;
                    height: parent.height;
                    vertical-alignment: center;
                    overflow: elide;
                    text: root.use-microsoft ? @tr("Microsoft account") : @tr("Offline profile");
                    font-size: 11.5px;
                    color: root.c-text;
                }
            }


        }

        // ---------------- play ----------------
        // `visible: false` still takes up space inside a layout, so the inactive
        // screen is removed with an `if` instead of being hidden.
        if !root.settings-open && !root.appearance-open : Rectangle {
            vertical-stretch: 1;

            Rectangle { width: parent.width; height: parent.height; y: (1 - root.page-progress) * 24px; opacity: 0.35 + 0.65 * max(0, min(1, root.page-progress));
            HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 14px;

            // profiles
            Rectangle {
                width: 320px;
                border-radius: 20px;
                border-width: 1px;
                border-color: root.c-border;
                background: root.c-panel;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        font-family: ThemePalette.body-font;
                        text: @tr("Profiles");
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: root.c-muted;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        min-height: 120px;

                        VerticalLayout {
                            spacing: 4px;
                            for name[i] in root.instance-names : ProfileRow {
                                entered: root.entry(i);
                                label: name;
                                dark: root.dark-mode;
                                selected: i == root.instance-index;
                                clicked => {
                                    root.instance-index = i;
                                    root.instance-selected(i);
                                }
                            }
                        }
                    }

                    AppButton {
                        label: @tr("Manage profiles");
                        dark: root.dark-mode;
                        enabled: !root.busy;
                        clicked => {
                            root.settings-section = 0; root.appearance-open = false; root.settings-open = true;
                        }
                    }
                }
            }

            // play: one action, no card border
            Rectangle {
                horizontal-stretch: 1;
                max-width: 100000px;

                VerticalLayout {
                    spacing: 6px;

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: root.current-profile;
                        font-family: ThemePalette.display-font;
                        opacity: ThemePalette.display-opacity;
                        font-size: 28px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        overflow: elide;
                        color: root.c-text;
                    }
                    Text {
                        font-family: ThemePalette.body-font;
                        text: @tr("Minecraft 1.21.11");
                        font-size: 12px;
                        horizontal-alignment: center;
                        color: root.c-muted;
                    }

                    Rectangle { height: 28px; }

                    HorizontalLayout {
                        alignment: center;
                        AppButton {
                            width: 420px;
                            height: 56px;
                            label: root.launch-busy
                                ? @tr("Working...")
                                : root.use-microsoft
                                    ? @tr("Play with Microsoft")
                                    : @tr("Play offline");
                            primary: true;
                            dark: root.dark-mode;
                            enabled: !root.busy;
                            clicked => { root.launch-offline(root.local-name); }
                        }
                    }

                    Rectangle { height: 12px; }

                    Text {
                        font-family: ThemePalette.body-font;
                        text: root.launch-status;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        font-size: 12px;
                        color: root.c-muted;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
            }
                    }
}

        // Grouped settings: one section list with values, one explanation/editor.
        if root.settings-open || root.appearance-open : Rectangle {
            vertical-stretch: 1;
            Rectangle { width: parent.width; height: parent.height; y: (1 - root.page-progress) * 18px; opacity: 0.35 + 0.65 * max(0, min(1, root.page-progress));
                HorizontalLayout {
                    width: 100%; height: 100%; spacing: 18px;
                    Rectangle {
                        width: root.width < 940px ? 214px : 252px;
                        border-radius: 22px; background: ThemePalette.panel;
                        border-width: 1px; border-color: ThemePalette.border;
                        VerticalLayout { padding: 16px; spacing: 10px;
                            Text { text: "SETTINGS"; font-family: ThemePalette.body-font; font-size: 11px; font-weight: 700; letter-spacing: 2px; color: ThemePalette.muted; }
                            for title[i] in ["Profiles", "Account & player", "Appearance"] : SectionRow {
                                label: title;
                                value: i == 0 ? root.current-profile : i == 1 ? (root.use-microsoft ? "Microsoft for Play" : "Offline / " + root.local-name) : root.selected-theme + (root.reduce-animations ? " / reduced motion" : " / animated");
                                selected: root.settings-section == i;
                                entered: root.entry(i);
                                clicked => { root.settings-section = i; root.appearance-open = i == 2; }
                            }
                            Rectangle { vertical-stretch: 1; }
                            Text { text: "One place for each setting.\nYour profiles stay where they are."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; }
                            Text { text: "ANDROMEDA / with Instinct"; font-family: ThemePalette.body-font; font-size: 10px; color: ThemePalette.muted; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1; border-radius: 22px; background: ThemePalette.panel;
                        border-width: 1px; border-color: ThemePalette.border;
                        ScrollView { x: 20px; y: 20px; width: parent.width - 40px; height: parent.height - 40px;
                            VerticalLayout { spacing: 14px; alignment: start;
                                Text { text: root.settings-section == 0 ? "Profiles" : root.settings-section == 1 ? "Account & player" : "Appearance"; font-family: ThemePalette.display-font; opacity: ThemePalette.display-opacity; font-size: 26px; font-weight: 800; color: ThemePalette.text-color; }
                                Text { text: root.settings-section == 0 ? "Create a profile or manage the one selected in Play. Each profile keeps its own game files." : root.settings-section == 1 ? "Choose your Play identity. Microsoft sign-in and the offline player name belong together here." : "Choose a theme and how much motion you want. The same layout and settings work across all themes."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.muted; }
                                if root.settings-section == 0 : VerticalLayout {
                                    vertical-stretch: 0; alignment: start; spacing: 12px;
                                    Text { text: "NEW PROFILE / COPY NAME"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    AppField { text <=> root.instance-name; placeholder: "Profile name"; enabled: !root.busy; }
                                    HorizontalLayout { spacing: 6px;
                                        for loader[i] in ["Vanilla", "Fabric", "Quilt", "Forge", "NeoForge"] : AppButton {
                                            horizontal-stretch: 1; label: loader; small: true; enabled: !root.busy;
                                            clicked => { root.manage-instance(i == 0 ? "create" : i == 1 ? "createfabric" : i == 2 ? "createquilt" : i == 3 ? "createforge" : "createneoforge", root.instance-name); }
                                        }
                                    }
                                    Rectangle { height: 1px; background: ThemePalette.border; }
                                    Text { text: "SELECTED IN PLAY"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    Text { text: root.current-profile; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 14px; font-weight: 600; color: ThemePalette.text-color; }
                                    Text { text: "Duplicate uses the name above. Trash is reversible. The default profile cannot be duplicated or trashed here."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; }
                                    HorizontalLayout { spacing: 6px;
                                        AppButton { horizontal-stretch: 1; label: "Duplicate"; small: true; enabled: !root.busy && root.instance-index > 0; clicked => { root.manage-instance("duplicate", root.instance-name); } }
                                        AppButton { horizontal-stretch: 1; label: root.trash-armed ? "Confirm trash" : "Move to trash"; small: true; danger: true; enabled: !root.busy && root.instance-index > 0; clicked => { root.manage-instance("trash", ""); } }
                                        AppButton { horizontal-stretch: 1; label: "Undo trash"; small: true; enabled: !root.busy && root.can-restore; clicked => { root.manage-instance("restore", ""); } }
                                    }
                                }
                                if root.settings-section == 1 : VerticalLayout {
                                    vertical-stretch: 0; alignment: start; spacing: 12px;
                                    Text { text: "MICROSOFT ACCOUNT"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    Text { text: root.account-status; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 12px; color: ThemePalette.text-color; }
                                    HorizontalLayout { spacing: 6px;
                                        AppButton { horizontal-stretch: 1; label: "Sign in"; primary: !root.use-microsoft; enabled: !root.busy; clicked => { root.account-action("signin"); } }
                                        AppButton { horizontal-stretch: 1; label: "Cancel sign-in"; enabled: root.auth-busy; clicked => { root.account-action("cancel"); } }
                                        AppButton { horizontal-stretch: 1; label: "Sign out"; enabled: !root.busy; clicked => { root.account-action("signout"); } }
                                    }
                                    AppSwitch { label: "Use Microsoft for Play"; checked <=> root.use-microsoft; enabled: !root.busy; }
                                    Rectangle { height: 1px; background: ThemePalette.border; }
                                    Text { text: "OFFLINE PLAYER"; font-family: ThemePalette.body-font; font-size: 10px; letter-spacing: 1px; color: ThemePalette.nav-accent; }
                                    AppField { text <=> root.local-name; placeholder: "Ingame name"; enabled: !root.busy; }
                                    Text { text: "Offline play is singleplayer only. Microsoft play verifies your Java entitlement. Switching identity does not delete your game profiles."; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 11px; color: ThemePalette.muted; }
                                }
                                if root.settings-section == 2 : VerticalLayout {
                                    vertical-stretch: 0; alignment: start; spacing: 10px;
                                    for choice[i] in root.theme-choices : ThemeRow {
                                        choice: choice; selected: choice.id == root.selected-theme; entered: root.entry(i);
                                        clicked => { root.theme-selected(choice.id); }
                                    }
                                    AppSwitch { label: "Reduce animations"; checked <=> root.reduce-animations; toggled => { root.settings-changed(); } }
                                    Text { text: root.theme-status; wrap: word-wrap; font-family: ThemePalette.body-font; font-size: 10px; color: ThemePalette.muted; }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------- intro overlay ----------------
    Rectangle {
        visible: root.intro-visible;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #10121d;

        Image {
            width: 100%;
            height: 100%;
            source: root.intro-frame;
            image-fit: contain;
        }

        Text {
            font-family: ThemePalette.body-font;
            x: 0px;
            y: parent.height - 48px;
            width: parent.width;
            text: @tr("Click to skip intro");
            horizontal-alignment: center;
            color: #9da2b8;
            font-size: 13px;
        }

        TouchArea {
            clicked => { root.intro-visible = false; }
        }
    }
}
