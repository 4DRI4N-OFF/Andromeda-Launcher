import { Switch, LineEdit, Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: @tr("Andromeda Launcher");
    preferred-width: 960px;
    preferred-height: 600px;
    in-out property <bool> reduce-animations;
    in-out property <bool> dark-mode: true;
    in-out property <bool> intro-visible: false;
    in property <image> intro-frame;
    callback settings-changed();
    callback launch-offline(string);
    in-out property <string> local-name: "Player";
    in-out property <bool> launch-busy: false;
    in-out property <string> launch-status: "Install 1.21.11 with the download tool first.";

    background: dark-mode ? #0b1020 : #f3f5fb;

    Rectangle {
        visible: !root.intro-visible;
        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            Text {
                text: @tr("Andromeda");
                font-size: 40px;
                font-weight: 800;
                color: root.dark-mode ? #e8ecff : #10142a;
            }
            Text {
                text: @tr("Play installed vanilla Minecraft with a local profile");
                font-size: 16px;
                color: root.dark-mode ? #8d97c4 : #4a5280;
            }
            Text {
                text: @tr("Local profile - vanilla 1.21.11");
                font-size: 18px;
                color: root.dark-mode ? #e8ecff : #10142a;
            }
            LineEdit {
                text <=> root.local-name;
                placeholder-text: @tr("Local name (1-16 letters, numbers or _)");
                enabled: !root.launch-busy;
            }
            Button {
                text: root.launch-busy ? @tr("Game running...") : @tr("Play offline");
                enabled: !root.launch-busy;
                clicked => { root.launch-offline(root.local-name); }
            }
            Text {
                text: root.launch-status;
                wrap: word-wrap;
                color: root.dark-mode ? #b5bedf : #4a5280;
                font-size: 14px;
            }
            Text {
                text: @tr("Local singleplayer only. Microsoft sign-in is not available yet. Use a Minecraft license you own.");
                wrap: word-wrap;
                color: root.dark-mode ? #8d97c4 : #4a5280;
                font-size: 12px;
            }

            Rectangle { vertical-stretch: 1; }
            Switch {
                text: @tr("Reduce animations");
                checked <=> root.reduce-animations;
                toggled => { root.settings-changed(); }
            }
            Switch {
                text: @tr("Dark mode");
                checked <=> root.dark-mode;
                toggled => { root.settings-changed(); }
            }
        }
    }
    Rectangle {
        visible: root.intro-visible;
        background: #10121d;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.intro-frame;
            image-fit: contain;
        }
        Text {
            x: 0px;
            y: parent.height - 48px;
            width: parent.width;
            text: @tr("Click to skip intro");
            horizontal-alignment: center;
            color: #9da2b8;
            font-size: 13px;
        }
        TouchArea { clicked => { root.intro-visible = false; } }
    }
}
