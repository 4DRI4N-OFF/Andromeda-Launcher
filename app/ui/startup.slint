export component SplashWindow inherits Window {
    width: 720px; height: 405px; no-frame: true; always-on-top:true; background: black; title: "Andromeda";
    callback retry;
    callback cancel;
    in property <string> failure: "";
    in property <[StartupGlyph]> glyphs;
    in property <float> planet-x: 960; in property <float> planet-y: 540; in property <float> planet-size: 650;
    in property <bool> letters-visible: false;
    in property <image> cover-mask;
    in property <string> arc-commands: "";
    Rectangle { width: parent.width; height: parent.height; background: #080611; clip: true;
        Image { width:parent.width;height:parent.height;source:@image-url("../assets/startup/backdrop.png");image-fit:fill; }
        StartupLogo { width: parent.width; height: parent.height; glyphs: root.letters-visible ? root.glyphs : [];
            planet-x: root.planet-x; planet-y: root.planet-y; planet-size: root.planet-size;
            loading: !root.letters-visible; arc-commands: root.arc-commands;cover-mask:root.cover-mask; }
    }
    if root.failure != "" : Rectangle { width:100%;height:100%;background:#100b20;
        Text { x:24px;y:70px;width:parent.width - 48px;height:120px;text:root.failure;wrap:word-wrap;color:white;font-size:16px; }
        Rectangle { x:150px;y:250px;width:180px;height:44px;border-radius:10px;background:#5c3f91;
            Text {text:"Reintentar";color:white;horizontal-alignment:center;vertical-alignment:center;width:100%;height:100%;}
            TouchArea {clicked=>{root.retry();}}
        }
        Rectangle { x:390px;y:250px;width:180px;height:44px;border-radius:10px;background:#30243d;
            Text {text:"Cerrar";color:white;horizontal-alignment:center;vertical-alignment:center;width:100%;height:100%;}
            TouchArea {clicked=>{root.cancel();}}
        }
    }
}
