import { ScrollView } from "std-widgets.slint";

// Native Slint view. Models and actions are supplied by the existing Rust app.
component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> reduced-motion: false;
    callback clicked();
    height: 44px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: primary ? #5aafff : #ffffff20;
    background: primary ? (touch.pressed ? #136fd1 : touch.has-hover ? #389dff : #1888f2) : (touch.pressed ? #30323b : touch.has-hover ? #292c34 : #ffffff0c);
    opacity: enabled ? 1 : 0.4;
    animate background { duration: 120ms; }
    Text { text: root.label; color: #f5f6fa; font-family: "Inter"; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

export component LibraryView inherits Rectangle {
    in property <string> body-font: "Inter";
    in property <[string]> names;
    in property <[string]> details;
    in property <int> selected-index: -1;
    in property <bool> busy: false;
    in property <bool> reduced-motion: false;
    in property <string> player-name: "Player";
    in property <string> status;
    in property <bool> show-navigation: true;
    pure callback matches(string, string) -> bool;
    callback select(int);
    callback play();
    callback navigate(int);
    callback create();
    callback account();
    in-out property <string> query;
    out property <bool> has-selection: selected-index >= 0 && selected-index < names.length;
    out property <string> selected-name: has-selection ? names[selected-index] : "Your library";
    property <bool> compact: root.width < 1100px;
    property <length> sidebar-width: compact ? 178px : 224px;
    background: #08090c;

    if root.show-navigation : Rectangle {
        x: 16px; y: 16px; width: root.sidebar-width; height: parent.height - 32px;
        border-radius: 26px; border-width: 1px; border-color: #ffffff16;
        background: @linear-gradient(150deg, #ffffff0e, #ffffff04);
        Image { x: 22px; y: 28px; width: parent.width - 44px; height: 42px; source: @image-url("branding/andromeda-light.svg"); image-fit: contain; }
        for title[i] in ["Library", "Instances", "Mods", "Settings"] : Rectangle {
            x: 12px; y: 112px + i * 54px; width: parent.width - 24px; height: 44px;
            border-radius: 22px; border-width: i == 0 ? 1px : 0px; border-color: #ffffff23;
            background: i == 0 ? #ffffff15 : nav-touch.has-hover ? #ffffff0a : transparent;
            Text { x: 18px; width: parent.width - 36px; text: title; font-family: root.body-font; font-size: 14px; font-weight: i == 0 ? 600 : 400; color: i == 0 ? #f2f3f7 : #a2a6b2; vertical-alignment: center; }
            nav-touch := TouchArea { mouse-cursor: pointer; clicked => { root.navigate(i); } }
        }
        Rectangle { x: 22px; y: parent.height - 94px; width: parent.width - 44px; height: 1px; background: #ffffff12; }
        Rectangle { x: 12px; y: parent.height - 82px; width: parent.width - 24px; height: 68px; border-radius: 20px; background: profile-touch.has-hover ? #ffffff0a : transparent;
            Rectangle { x: 12px; y: 15px; width: 36px; height: 36px; border-radius: 18px; background: #282536;
                Text { text: "A"; font-family: root.body-font; font-size: 15px; font-weight: 600; color: #d6ccf7; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { x: 60px; y: 13px; width: parent.width - 66px; height: 22px; text: root.player-name; color: #e5e7ed; font-family: root.body-font; font-size: 13px; font-weight: 600; overflow: elide; }
            Text { x: 60px; y: 36px; width: parent.width - 66px; height: 18px; text: "Account"; color: #9398a8; font-family: root.body-font; font-size: 11px; }
            profile-touch := TouchArea { mouse-cursor: pointer; clicked => { root.account(); } }
        }
    }
    content := Rectangle {
        x: root.show-navigation ? root.sidebar-width + 48px : 0px;
        y: root.show-navigation ? 34px : 0px;
        width: parent.width - self.x - (root.show-navigation ? 32px : 0px);
        height: parent.height - self.y - (root.show-navigation ? 30px : 0px);
        property <bool> narrow: self.width < 760px;
        Text { y: 10px; width: parent.width; height: 42px; text: "Library"; font-family: root.body-font; font-size: 34px; font-weight: 700; color: #f3f4f7; }
        Text { y: 58px; width: parent.width; height: 22px; text: "Minecraft: Java Edition"; font-family: root.body-font; font-size: 13px; color: #969baa; }
        search := Rectangle {
            x: parent.narrow ? 0px : parent.width - 420px;
            y: parent.narrow ? 94px : 22px;
            width: parent.narrow ? max(120px, parent.width - 170px) : 244px;
            height: 44px; border-radius: 22px; border-width: 1px; border-color: search-input.has-focus ? #5aafff : #ffffff20; background: #ffffff08;
            Text { x: 18px; width: parent.width - 36px; text: "Search instances"; color: #858c9e; font-family: root.body-font; font-size: 13px; vertical-alignment: center; visible: root.query == ""; }
            search-input := TextInput { x: 18px; width: parent.width - 36px; height: parent.height; text <=> root.query; color: #e9ebf1; font-family: root.body-font; font-size: 13px; vertical-alignment: center; single-line: true; }
        }
        PillButton { x: parent.width - 158px; y: parent.narrow ? 94px : 22px; width: 158px; label: "+  New instance"; enabled: !root.busy; clicked => { root.create(); } }
        hero := Rectangle {
            y: parent.narrow ? 148px : 108px; width: parent.width;
            height: content.narrow && root.height < 700px ? 176px : min(360px, max(200px, root.height * 0.37));
            border-radius: 28px; clip: true; background: #151822;
            Image { x: parent.width * 0.29; width: parent.width * 0.71; height: parent.height; source: @image-url("landscape.svg"); image-fit: cover; opacity: 0.58; }
            Rectangle { width: 100%; height: 100%; background: @linear-gradient(90deg, #13151d 5%, #13151de8 32%, #11131a20 100%); }
            Rectangle { width: 100%; height: 100%; border-radius: 28px; border-width: 1px; border-color: #ffffff1c; }
            Text { x: 28px; y: parent.height - 169px; width: parent.width - 56px; height: 22px; text: root.has-selection ? "CONTINUE PLAYING" : "MAKE IT YOURS"; font-family: root.body-font; font-size: 11px; font-weight: 600; letter-spacing: 1.2px; color: #b1b8ca; }
            Text { x: 28px; y: parent.height - 140px; width: parent.width - 56px; height: 43px; text: root.selected-name; font-family: root.body-font; font-size: content.narrow ? 26px : 34px; font-weight: 700; color: #fafbff; overflow: elide; }
            Text { x: 28px; y: parent.height - 91px; width: parent.width - 56px; height: 22px; text: root.has-selection && root.selected-index < root.details.length ? root.details[root.selected-index] : "Create or select an instance to start playing."; font-family: root.body-font; font-size: 12px; color: #aeb5c7; overflow: elide; }
            PillButton { x: 28px; y: parent.height - 59px; width: 130px; label: root.busy && root.has-selection ? "Preparing…" : "Play"; primary: true; enabled: root.has-selection && !root.busy; clicked => { root.play(); } }
        }
        Text { y: hero.y + hero.height + 26px; height: 28px; width: parent.width; text: "Your instances"; font-family: root.body-font; font-size: 20px; font-weight: 600; color: #e7e9f0; }
        list := ScrollView {
            y: hero.y + hero.height + 70px; width: parent.width;
            height: max(70px, parent.height - self.y - (root.status == "" ? 4px : 34px));
            horizontal-scrollbar-policy: always-off;
            VerticalLayout { padding: 0px; spacing: 14px;
                for row in ceil(root.names.length / (content.narrow ? 2 : 3)) : HorizontalLayout {
                    spacing: 14px;
                    for col in (content.narrow ? 2 : 3) : Rectangle {
                        property <int> index: row * (content.narrow ? 2 : 3) + col;
                        property <bool> valid: self.index < root.names.length;
                        height: 142px;
                        opacity: !self.valid ? 0 : root.query == "" || root.matches(root.names[self.index], root.query) ? 1 : 0;
                        border-radius: 22px; border-width: 1px; border-color: self.index == root.selected-index ? #578bb576 : #ffffff17;
                        background: row-touch.has-hover ? #1a1d25 : #12141b;
                        Rectangle { x: 20px; y: 19px; width: 36px; height: 36px; border-radius: 12px; background: #9e8ed71a;
                            Text { text: "◇"; color: #c4b5ec; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { x: 20px; y: 70px; width: parent.width - 40px; height: 25px; text: parent.valid ? root.names[parent.index] : ""; font-family: root.body-font; font-size: 15px; font-weight: 600; color: #e8eaf0; overflow: elide; }
                        Text { x: 20px; y: 103px; width: parent.width - 64px; height: 20px; text: parent.index < root.details.length ? root.details[parent.index] : ""; font-family: root.body-font; font-size: 12px; color: #9299ab; overflow: elide; }
                        Text { x: parent.width - 46px; y: 100px; width: 30px; height: 26px; text: parent.index == root.selected-index ? "●" : "›"; color: parent.index == root.selected-index ? #79b9f3 : #818a9f; horizontal-alignment: center; vertical-alignment: center; }
                        row-touch := TouchArea { enabled: parent.valid && !root.busy && (root.query == "" || root.matches(root.names[parent.index], root.query)); mouse-cursor: self.enabled ? pointer : default; clicked => { root.select(parent.index); } }
                    }
                }
                if root.names.length == 0 : Text { height: 70px; text: "No instances yet. Create your first one above."; color: #a1a8b9; font-family: root.body-font; font-size: 14px; vertical-alignment: center; }
            }
        }

        Text { y: parent.height - 24px; height: 24px; width: parent.width; text: root.status; visible: root.status != ""; overflow: elide; font-family: root.body-font; font-size: 11px; color: #929bad; }
    }
}
