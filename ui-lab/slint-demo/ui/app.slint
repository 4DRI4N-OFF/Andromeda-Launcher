export struct GameCard {
    title: string,
    version: string,
    hours: string,
    cover: image,
}

component Card inherits Rectangle {
    in property <GameCard> card;
    border-radius: 20px;
    background: #FFFFFFF2;
    drop-shadow-blur: 18px;
    drop-shadow-color: #6B639933;
    drop-shadow-offset-y: 6px;
    scale: ta.pressed ? 0.96 : 1.0;
    animate scale { duration: 240ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            clip: true;
            Image {
                source: card.cover;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 2px;
            padding-left: 4px;
            padding-bottom: 2px;
            Text {
                text: card.title;
                font-size: 15px;
                font-weight: 700;
                color: #2E2A45;
            }
            Text {
                text: card.version + "  ·  " + card.hours;
                font-size: 12px;
                color: #7A7593;
            }
        }
    }
    ta := TouchArea { }
}

export component MainWindow inherits Window {
    title: demo-step >= 8 ? "Andromeda UI Lab (Slint) DONE" : "Andromeda UI Lab (Slint)";
    width: 1100px;
    height: 680px;
    background: @linear-gradient(180deg, #ECEAF7 0%, #DFDCF1 100%);

    in property <bool> demo-mode: false;
    property <int> demo-step: 0;
    property <int> active-tab: 0;
    callback demo-done();

    property <[string]> tabs: ["Inicio", "Biblioteca", "Instancias", "Ajustes"];
    property <[GameCard]> cards: [
        { title: "Survival Alba", version: "1.21.4 · Fabric", hours: "132 h", cover: @image-url("assets/cover0.svg") },
        { title: "Creativo Horizonte", version: "1.21.1 · Vanilla", hours: "87 h", cover: @image-url("assets/cover1.svg") },
        { title: "Hardcore Cartógrafo", version: "1.20.6 · NeoForge", hours: "54 h", cover: @image-url("assets/cover2.svg") },
        { title: "Skyblock+", version: "1.21.3 · Quilt", hours: "41 h", cover: @image-url("assets/cover3.svg") },
        { title: "PvP Arena", version: "1.8.9 · LegacyFabric", hours: "26 h", cover: @image-url("assets/cover4.svg") },
        { title: "Beta Nostalgia", version: "b1.7.3 · Ornithe", hours: "12 h", cover: @image-url("assets/cover5.svg") },
    ];

    // ambient background blobs
    Rectangle {
        x: -120px; y: -80px; width: 480px; height: 480px; border-radius: 240px;
        background: @radial-gradient(circle, #B9A9F5AA 0%, #B9A9F500 70%);
    }
    Rectangle {
        x: 720px; y: 60px; width: 460px; height: 460px; border-radius: 230px;
        background: @radial-gradient(circle, #F2B8D8AA 0%, #F2B8D800 70%);
    }
    Rectangle {
        x: 300px; y: 380px; width: 520px; height: 420px; border-radius: 260px;
        background: @radial-gradient(circle, #A9C7F599 0%, #A9C7F500 70%);
    }

    // top bar
    Rectangle {
        x: 28px; y: 20px; height: 44px; width: parent.width - 56px;
        HorizontalLayout {
            spacing: 12px;
            Image { source: @image-url("assets/planet.svg"); width: 36px; height: 36px; }
            Text {
                text: "Andromeda";
                font-size: 22px; font-weight: 800; color: #3A3358;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 280px; height: 40px; border-radius: 20px;
                background: #FFFFFF66;
                border-width: 1px; border-color: #FFFFFFCC;
                backdrop-blur: 18px;
                HorizontalLayout {
                    padding-left: 14px; spacing: 8px;
                    Text { text: "⌕"; vertical-alignment: center; font-size: 17px; color: #6E6890; }
                    Text { text: "Buscar en tu biblioteca"; vertical-alignment: center; font-size: 13px; color: #6E6890; }
                }
            }
        }
    }

    // scrollable card grid
    flick := Flickable {
        x: 28px; y: 84px;
        width: parent.width - 56px;
        height: parent.height - 84px - 104px;
        viewport-width: self.width;
        viewport-height: 3 * 246px;
        animate viewport-y { duration: 650ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        for card[i] in cards : Card {
            card: card;
            x: mod(i, 2) * (515px + 14px);
            y: floor(i / 2) * 246px;
            width: 515px;
            height: 230px;
        }
    }

    // floating glass nav
    Rectangle {
        x: (parent.width - 470px) / 2;
        y: parent.height - 92px;
        width: 470px; height: 64px;
        border-radius: 32px;
        background: #FFFFFF8C;
        backdrop-blur: 24px;
        border-width: 1px; border-color: #FFFFFFD9;
        drop-shadow-blur: 24px; drop-shadow-color: #5B548A33; drop-shadow-offset-y: 8px;

        Rectangle {
            x: 8px + active-tab * 114px;
            y: 8px; width: 109px; height: 48px; border-radius: 24px;
            background: #7C6BE833;
            animate x { duration: 420ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
        }
        for t[idx] in tabs : Rectangle {
            x: 8px + idx * 114px; y: 8px; width: 109px; height: 48px;
            Text {
                text: t;
                font-size: 13px;
                font-weight: idx == active-tab ? 700 : 400;
                color: idx == active-tab ? #4A3FA3 : #6E6890;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { active-tab = idx; } }
        }
    }

    // scripted demo
    Timer {
        interval: 900ms;
        running: root.demo-mode && demo-step < 8;
        triggered => {
            demo-step = demo-step + 1;
            if demo-step == 1 { flick.viewport-y = -160px; }
            if demo-step == 2 { flick.viewport-y = -242px; }
            if demo-step == 3 { active-tab = 1; }
            if demo-step == 4 { active-tab = 2; flick.viewport-y = 0; }
            if demo-step == 5 { active-tab = 0; }
            if demo-step == 6 { flick.viewport-y = -120px; }
            if demo-step == 7 { flick.viewport-y = 0; }
            if demo-step >= 8 { root.demo-done(); }
        }
    }
}
